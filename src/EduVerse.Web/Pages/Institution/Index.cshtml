@page
@model EduVerse.Web.Pages.Institution.IndexModel
@using EduVerse.Core.Institutions
@{
    var d = Model.Dashboard;
    var culture = System.Globalization.CultureInfo.CurrentCulture;
    ViewData["Title"] = d.Institution.Name;
    var high = d.Risks.Count(r => r.Level == RiskLevel.High);
    var avgProgress = d.Classes.Count == 0 ? 0 : (int)Math.Round(d.Classes.Average(c => c.Progress));
}
<div class="flex flex-wrap justify-between items-end gap-3">
    <div class="min-w-0">
        <h1 class="text-3xl font-semibold tracking-tight text-foreground" data-greeting="@User.DisplayName()">@string.Format(culture, L["Teacher_Hello"], User.DisplayName())</h1>
        <p class="mt-1 text-sm text-muted-foreground-1">@d.Institution.Name · @L["Institution_Subtitle"]</p>
    </div>
    <div class="flex items-center gap-2 p-1.5 ps-4 rounded-full border border-layer-line bg-layer tip tip-b" data-tip="@L["Institution_CodeHint"]">
        <span class="text-xs text-muted-foreground-1">@L["Institution_TeacherCode"]</span>
        <span class="font-mono text-lg font-semibold tracking-widest text-foreground" data-testid="institution-code">@d.Institution.Code</span>
        <button type="button" data-copy-text="@d.Institution.Code" class="py-1.5 px-3 text-xs font-semibold rounded-full bg-primary text-primary-foreground hover:bg-primary-hover">@L["Copy"]</button>
    </div>
</div>

<div class="grid sm:grid-cols-2 xl:grid-cols-4 gap-4 sm:gap-5">
    <div class="@Ui.Kpi tone-lavender">
        <p class="@Ui.KpiLabel">@L["Kpi_Students"]</p>
        <p class="@Ui.KpiValue">@d.Students</p>
        <p class="mt-auto pt-4 text-xs text-foreground/70">@string.Format(culture, L["Institution_Active"], d.ActiveStudents)</p>
    </div>
    <div class="@Ui.Kpi tone-sky">
        <div class="flex items-start justify-between gap-2"><p class="@Ui.KpiLabel">@L["Kpi_AnswersWeek"]</p>@Html.Raw(Ui.Trend(d.Activity.AnswersTrend))</div>
        <p class="@Ui.KpiValue">@d.Activity.Answers</p>
        <partial name="_MiniBars" model="d.Activity.Days" />
    </div>
    <div class="@Ui.Kpi tone-mint">
        <p class="@Ui.KpiLabel">@L["Kpi_Progress"]</p>
        <p class="@Ui.KpiValue">@avgProgress %</p>
        <div class="mt-auto pt-4 flex items-end gap-1.5 h-16" role="img" aria-label="@L["Kpi_Progress"]">
            @foreach (var c in d.Classes)
            {
                <div class="flex-1 max-w-10 rounded-lg overflow-hidden flex flex-col justify-end bar-hatch h-full tip" data-tip="@c.Name: @c.Progress %"><div class="bar-solid rounded-lg" style="height:@(Math.Max(4, c.Progress))%"></div></div>
            }
        </div>
    </div>
    <a href="/Institution/Risk?level=High" class="@Ui.Kpi tone-plum hover:-translate-y-0.5 transition-transform">
        <p class="text-sm font-semibold text-white/80">@L["Kpi_AtRisk"]</p>
        <p class="mt-2 text-4xl font-semibold tracking-tight">@high</p>
        <p class="mt-auto pt-4 text-sm text-white/70">@L["Kpi_AtRiskHint"] →</p>
    </a>
</div>

<div class="grid xl:grid-cols-12 gap-4 sm:gap-5 items-start">
    <section class="@Ui.Card xl:col-span-8 min-w-0" aria-labelledby="classes-title">
        <div class="@Ui.CardHeader"><h2 id="classes-title" class="text-base font-semibold text-foreground">@L["Institution_Classes"]</h2></div>
        @if (d.Classes.Count == 0)
        {
            <p class="p-6 text-sm text-muted-foreground-1">@string.Format(culture, L["Institution_NoClasses"], d.Institution.Code)</p>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="min-w-full text-sm" data-testid="institution-classes">
                    <thead><tr class="border-b border-card-divider text-xs text-muted-foreground-1">
                        <th scope="col" class="py-3 px-5 text-start font-medium">@L["Institution_Class"]</th>
                        <th scope="col" class="py-3 px-3 text-start font-medium">@L["Role_Teacher"]</th>
                        <th scope="col" class="py-3 px-3 text-end font-medium">@L["Kpi_Students"]</th>
                        <th scope="col" class="py-3 px-3 text-start font-medium min-w-36">@L["Kpi_Progress"]</th>
                        <th scope="col" class="py-3 px-3 text-end font-medium">@L["Kpi_AnswersWeek"]</th>
                        <th scope="col" class="py-3 px-5 text-end font-medium">@L["Kpi_Alerts"]</th>
                    </tr></thead>
                    <tbody class="divide-y divide-card-divider">
                        @foreach (var c in d.Classes)
                        {
                            <tr>
                                <td class="py-3 px-5"><span class="font-semibold text-foreground">@c.Name</span><span class="block text-xs text-muted-foreground-1">@c.Subject</span></td>
                                <td class="py-3 px-3 whitespace-nowrap"><span class="inline-flex items-center gap-2"><span class="size-7 grid place-items-center rounded-full text-[10px] font-bold text-foreground @Ui.AvatarTone(c.Teacher)">@Ui.Initials(c.Teacher)</span>@c.Teacher</span></td>
                                <td class="py-3 px-3 text-end">@c.Students</td>
                                <td class="py-3 px-3"><div class="flex items-center gap-2"><div class="grow h-2 rounded-full bg-surface overflow-hidden"><div class="h-full rounded-full bar-solid" style="width:@(c.Progress)%"></div></div><span class="text-xs w-9 text-end">@c.Progress %</span></div></td>
                                <td class="py-3 px-3 text-end">@c.AnswersThisWeek</td>
                                <td class="py-3 px-5 text-end">@if (c.OpenAlerts > 0) { <span class="@Ui.Pill bg-primary text-primary-foreground">@c.OpenAlerts</span> } else { <span class="text-muted-foreground-1">0</span> }</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <aside class="xl:col-span-4 space-y-4 sm:space-y-5 min-w-0">
        <section class="@Ui.Card p-5" aria-labelledby="risk-title">
            <div class="flex items-center justify-between gap-2">
                <h2 id="risk-title" class="text-base font-semibold text-foreground">@L["Nav_Risk"]</h2>
                <a href="/Institution/Risk" class="text-sm font-semibold text-primary hover:underline">@L["SeeAll"]</a>
            </div>
            <ul class="mt-3 divide-y divide-card-divider">
                @foreach (var r in d.Risks.Take(4))
                {
                    <li class="py-3 flex items-center gap-3">
                        <span class="size-10 shrink-0 grid place-items-center rounded-full text-xs font-bold text-foreground @Ui.AvatarTone(r.Student.Name)">@Ui.Initials(r.Student.Name)</span>
                        <div class="min-w-0 grow">
                            <p class="text-sm font-semibold text-foreground truncate">@r.Student.Name</p>
                            <p class="text-xs text-muted-foreground-1 truncate">@string.Join(" · ", r.Factors.Take(2).Select(f => string.Format(culture, L[$"Risk_{f.Code}"], f.Value)))</p>
                        </div>
                        <span class="@Ui.Pill @RiskClass(r.Level)">@r.Score</span>
                    </li>
                }
            </ul>
        </section>
        <section class="@Ui.Card p-5" aria-labelledby="teachers-title">
            <h2 id="teachers-title" class="text-base font-semibold text-foreground">@L["Institution_Teachers"]</h2>
            <ul class="mt-3 divide-y divide-card-divider">
                @foreach (var t in d.Teachers)
                {
                    <li class="py-3 flex items-center gap-3">
                        <span class="size-10 shrink-0 grid place-items-center rounded-full text-xs font-bold text-foreground @Ui.AvatarTone(t.Name)">@Ui.Initials(t.Name)</span>
                        <div class="min-w-0 grow">
                            <p class="text-sm font-semibold text-foreground truncate">@t.Name</p>
                            <p class="text-xs text-muted-foreground-1">@string.Format(culture, L["Institution_TeacherLine"], t.Classes, t.Students)</p>
                        </div>
                        @if (t.OpenAlerts > 0)
                        {
                            <span class="@Ui.Pill bg-primary text-primary-foreground">@string.Format(culture, L["Teacher_AlertsCount"], t.OpenAlerts)</span>
                        }
                    </li>
                }
            </ul>
            <p class="mt-3 text-xs text-muted-foreground-1">@L["Institution_CodeHint"]</p>
        </section>
    </aside>
</div>

@functions {
    static string RiskClass(RiskLevel level) => level switch
    {
        RiskLevel.High => "heat-1",
        RiskLevel.Medium => "heat-2",
        _ => "heat-5",
    };
}

@section Scripts {
    <script src="~/js/common.js" asp-append-version="true"></script>
    <script>Edu.copyButtons(document);</script>
}
