@page
@model EduVerse.Web.Pages.Institution.QualityModel
@{
    ViewData["Title"] = L["Nav_Quality"];
    var q = Model.Dashboard.Quality;
    var bill = Model.Dashboard.Bill;
    var culture = System.Globalization.CultureInfo.CurrentCulture;
    string Money(decimal v) => Ui.Money(v);
}
<div>
    <h1 class="text-3xl font-semibold tracking-tight text-foreground">@L["Nav_Quality"]</h1>
    <p class="mt-1 text-sm text-muted-foreground-1 max-w-3xl">@L["Quality_Subtitle"]</p>
</div>

<div class="grid sm:grid-cols-2 xl:grid-cols-4 gap-4 sm:gap-5">
    <div class="@Ui.Kpi tone-lavender">
        <p class="@Ui.KpiLabel">@L["Quality_Best"]</p>
        <p class="mt-2 text-2xl font-semibold text-foreground">@(q.Best is { } b ? L[$"Method_{b}"] : "–")</p>
        <p class="mt-auto pt-4 text-xs text-foreground/70">@L["Quality_BestHint"]</p>
    </div>
    <div class="@Ui.Kpi tone-mint">
        <p class="@Ui.KpiLabel">@L["Quality_Mastered"]</p>
        <p class="@Ui.KpiValue">@q.ConceptsMastered</p>
        <p class="mt-auto pt-4 text-xs text-foreground/70">@string.Format(culture, L["Quality_AfterSwitch"], q.MasteredAfterSwitch)</p>
    </div>
    <div class="@Ui.Kpi tone-pink">
        <p class="@Ui.KpiLabel">@L["Quality_Alerts"]</p>
        <p class="@Ui.KpiValue">@q.AlertsResolved<span class="text-xl text-foreground/50"> / @(q.AlertsResolved + q.AlertsOpen)</span></p>
        <p class="mt-auto pt-4 text-xs text-foreground/70">@(q.AverageHoursToResolve is { } h ? string.Format(culture, L["Quality_Hours"], h) : L["Quality_NoResolved"])</p>
    </div>
    <div class="@Ui.Kpi tone-plum">
        <p class="text-sm font-semibold text-white/80">@L["Plan_Monthly"]</p>
        <p class="mt-2 text-4xl font-semibold tracking-tight">@Money(bill.Total)</p>
        <p class="mt-auto pt-4 text-sm text-white/70">@(bill.PerActiveStudent is { } p ? string.Format(culture, L["Plan_PerActive"], Money(p)) : "")</p>
    </div>
</div>

<div class="grid xl:grid-cols-12 gap-4 sm:gap-5 items-start">
    <section class="@Ui.Card xl:col-span-7 p-5 min-w-0" aria-labelledby="methods-title">
        <h2 id="methods-title" class="text-base font-semibold text-foreground">@L["Quality_Methods"]</h2>
        <p class="mt-1 text-xs text-muted-foreground-1">@L["Quality_MethodsHint"]</p>
        <ul class="mt-4 space-y-4" data-testid="methods">
            @foreach (var m in q.Methods)
            {
                <li>
                    <div class="flex items-center justify-between gap-3 text-sm">
                        <span class="font-medium text-foreground">@L[$"Method_{m.Method}"] @if (q.Best == m.Method) { <span class="ms-1 @Ui.Pill bg-primary text-primary-foreground">@L["Quality_BestTag"]</span> }</span>
                        <span class="text-xs text-muted-foreground-1">@(m.Rate is { } r ? $"{r} %" : "–") · @string.Format(culture, L["Heat_Attempts"], m.Answers)</span>
                    </div>
                    <div class="mt-1.5 h-3 rounded-full bar-hatch overflow-hidden"><div class="h-full rounded-full bar-solid" style="width:@(m.Rate ?? 0)%"></div></div>
                </li>
            }
        </ul>
    </section>
    <section class="@Ui.Card xl:col-span-5 p-5 min-w-0" aria-labelledby="plan-title">
        <h2 id="plan-title" class="text-base font-semibold text-foreground">@L["Plan_Title"]</h2>
        <dl class="mt-4 divide-y divide-card-divider text-sm">
            <div class="py-2.5 flex justify-between gap-3"><dt class="text-muted-foreground-1">@L["Plan_Name"]</dt><dd class="font-semibold text-foreground">@L["Plan_Academy"]</dd></div>
            <div class="py-2.5 flex justify-between gap-3"><dt class="text-muted-foreground-1">@L["Plan_Base"]</dt><dd class="text-foreground">@Money(bill.Plan.MonthlyBase) · @string.Format(culture, L["Plan_Included"], bill.Plan.IncludedStudents)</dd></div>
            <div class="py-2.5 flex justify-between gap-3"><dt class="text-muted-foreground-1">@L["Plan_Extra"]</dt><dd class="text-foreground">@Money(bill.Plan.ExtraStudent)</dd></div>
            <div class="py-2.5 flex justify-between gap-3"><dt class="text-muted-foreground-1">@L["Kpi_Students"]</dt><dd class="text-foreground">@bill.Students · @string.Format(culture, L["Institution_Active"], bill.ActiveStudents)</dd></div>
            <div class="py-2.5 flex justify-between gap-3"><dt class="text-muted-foreground-1">@L["Plan_FreeSeats"]</dt><dd class="text-foreground">@bill.FreeSeats</dd></div>
            <div class="py-2.5 flex justify-between gap-3"><dt class="font-semibold text-foreground">@L["Plan_Monthly"]</dt><dd class="font-semibold text-foreground">@Money(bill.Total)</dd></div>
        </dl>
        <p class="mt-3 text-xs text-muted-foreground-1">@L["Plan_Hint"]</p>
    </section>
</div>
