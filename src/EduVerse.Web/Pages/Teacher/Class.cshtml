@page
@model EduVerse.Web.Pages.Teacher.ClassModel
@using EduVerse.Core.Learning
@using EduVerse.Infrastructure.Data
@{
    var d = Model.Detail;
    var report = d.Report;
    var language = Localization.LanguageForCurrentCulture();
    var culture = System.Globalization.CultureInfo.CurrentCulture;
    ViewData["Title"] = d.Classroom.Name;
    EduVerse.Web.Breadcrumb.Set(ViewData, d.Classroom.Name, ("/Teacher", L["Nav_Classes"]));
    string ConceptName(string key) => d.Subject.Find(key)?.Name ?? key;
    string Methods(string? detail) => string.Join(" → ", (detail ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries).Select(m => L[$"Method_{m}"].Value));
}
<div class="flex flex-wrap justify-between items-end gap-3">
    <div class="min-w-0">
        <h1 class="text-2xl font-semibold text-foreground">@d.Classroom.Name</h1>
        <p class="mt-1 text-sm text-muted-foreground-1">@d.Subject.Name</p>
    </div>
    <div class="flex items-center gap-2 p-1.5 ps-4 rounded-full border border-layer-line bg-layer">
        <span class="text-xs text-muted-foreground-1">@L["Teacher_Code"]</span>
        <span class="font-mono text-lg font-semibold tracking-widest text-foreground" data-testid="class-code">@d.Classroom.Code</span>
        <button type="button" data-copy-text="@d.Classroom.Code" class="py-1.5 px-3 text-xs font-semibold rounded-full bg-primary text-primary-foreground hover:bg-primary-hover">@L["Copy"]</button>
    </div>
</div>

<div class="grid sm:grid-cols-2 xl:grid-cols-4 gap-4 sm:gap-5">
    <div class="@Ui.Kpi tone-lavender">
        <p class="@Ui.KpiLabel">@L["Kpi_Students"]</p>
        <p class="@Ui.KpiValue">@report.Rows.Count</p>
        <div class="mt-auto pt-4 flex -space-x-2">
            @foreach (var r in report.Rows.Take(6))
            {
                <span class="size-8 grid place-items-center rounded-full ring-2 ring-white dark:ring-[#1f1b23] text-[11px] font-bold text-foreground @Ui.AvatarTone(r.Name)" title="@r.Name">@Ui.Initials(r.Name)</span>
            }
        </div>
    </div>
    <div class="@Ui.Kpi tone-sky">
        <div class="flex items-start justify-between gap-2"><p class="@Ui.KpiLabel">@L["Kpi_ClassAnswers"]</p>@Html.Raw(Ui.Trend(Model.Activity.AnswersTrend))</div>
        <p class="@Ui.KpiValue">@Model.Activity.Answers</p>
        <partial name="_MiniBars" model="Model.Activity.Days" />
    </div>
    <div class="@Ui.Kpi tone-pink">
        <p class="@Ui.KpiLabel">@L["Kpi_Progress"]</p>
        <p class="@Ui.KpiValue">@report.AverageProgress %</p>
        <div class="mt-auto pt-4 flex items-end gap-1.5 h-16" role="img" aria-label="@L["Kpi_Progress"]">
            @foreach (var r in report.Rows)
            {
                <div class="flex-1 max-w-7 rounded-lg overflow-hidden flex flex-col justify-end bar-hatch h-full" title="@r.Name: @r.Progress %"><div class="bar-solid rounded-lg" style="height:@(Math.Max(4, r.Progress))%"></div></div>
            }
        </div>
    </div>
    <div class="@Ui.Kpi tone-plum">
        <p class="text-sm font-semibold text-white/80">@L["Kpi_Hardest"]</p>
        <p class="mt-2 text-xl font-semibold leading-snug">@(report.HardestConcept is { } hc ? ConceptName(hc) : "–")</p>
        <p class="mt-auto pt-4 text-sm text-white/70">@string.Format(culture, L["Kpi_OpenAlerts"], d.Alerts.Count)</p>
    </div>
</div>

<div class="grid xl:grid-cols-12 gap-4 sm:gap-5 items-start">
<div class="xl:col-span-8 min-w-0">
<section class="@Ui.Card min-w-0" aria-labelledby="heat-title">
    <div class="@Ui.CardHeader">
        <h2 id="heat-title" class="text-base font-semibold text-foreground">@L["Heat_Title"]</h2>
        <p class="text-xs text-muted-foreground-1">@L["Heat_Hint"]</p>
    </div>
    @if (report.Rows.Count == 0)
    {
        <p class="p-6 text-sm text-muted-foreground-1">@string.Format(culture, L["Heat_Empty"], d.Classroom.Code)</p>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="min-w-full text-sm" data-testid="heatmap">
                <thead>
                    <tr class="border-b border-card-divider">
                        <th scope="col" class="py-2 px-4 text-start font-medium text-muted-foreground-1 sticky start-0 bg-card">@L["Heat_Student"]</th>
                        @foreach (var c in report.Concepts)
                        {
                            <th scope="col" class="py-2 px-1 font-medium text-muted-foreground-1 text-xs min-w-16 max-w-24" title="@c.Name"><span class="line-clamp-2">@c.Name</span></th>
                        }
                        <th scope="col" class="py-2 px-4 text-end font-medium text-muted-foreground-1">@L["Heat_Progress"]</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-card-divider">
                    @foreach (var row in report.Rows)
                    {
                        <tr class="@(row.StudentId == Model.StudentId ? "bg-primary/5" : "")">
                            <th scope="row" class="py-2 px-4 text-start font-medium sticky start-0 bg-card">
                                <a class="text-foreground hover:text-primary hover:underline" href="/Teacher/Class?id=@d.Classroom.Id&student=@row.StudentId#student">@row.Name</a>
                                @if (row.AtRisk)
                                {
                                    <span class="ms-1 @Ui.Pill bg-primary text-primary-foreground text-[10px]">@L["Heat_AtRisk"]</span>
                                }
                            </th>
                            @foreach (var cell in row.Cells)
                            {
                                var label = cell.PKnown is { } p && cell.Attempts > 0 ? $"{Math.Round(p * 100)}" : "·";
                                <td class="p-1 text-center">
                                    <span class="block py-2.5 rounded-xl text-sm font-semibold @Ui.HeatClass(cell.Attempts > 0 ? cell.PKnown : null)"
                                          title="@ConceptName(cell.ConceptKey): @L[$"Status_{cell.Status}"] · @string.Format(culture, L["Heat_Attempts"], cell.Attempts)">@label</span>
                                </td>
                            }
                            <td class="py-2 px-4 text-end text-foreground">@row.Progress %</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="px-4 py-3 border-t border-card-divider flex flex-wrap gap-3 text-xs text-muted-foreground-1">
            @foreach (var (p, label) in new (double?, string)[] { (0.2, "< 40 %"), (0.5, "40-59 %"), (0.65, "60-74 %"), (0.8, "75-94 %"), (0.96, "≥ 95 %"), (null, L["Status_NotStarted"]) })
            {
                <span class="inline-flex items-center gap-1.5"><span class="size-3 rounded @Ui.HeatClass(p)"></span>@label</span>
            }
        </div>
    }
</section>
    <section class="@Ui.Card min-w-0 mt-4 sm:mt-5" aria-labelledby="alerts-title">
        <div class="@Ui.CardHeader"><h2 id="alerts-title" class="text-base font-semibold text-foreground">@L["Alerts_Title"]</h2></div>
        @if (d.Alerts.Count == 0)
        {
            <p class="p-4 md:p-5 text-sm text-muted-foreground-1">@L["Alerts_None"]</p>
        }
        <ul class="divide-y divide-card-divider" data-testid="alerts">
            @foreach (var a in d.Alerts)
            {
                <li class="p-4 md:px-5 flex items-start justify-between gap-3">
                    <div class="min-w-0 text-sm">
                        <p class="font-medium text-foreground">
                            <span class="me-1 @Ui.Pill text-[10px] uppercase @(a.Kind == AlertKind.NeedsTeacher ? "bg-primary text-primary-foreground" : "heat-2")">@L[$"AlertKind_{a.Kind}"]</span>
                            @a.StudentName · @a.ConceptName
                        </p>
                        <p class="mt-1 text-muted-foreground-1">
                            @if (a.Kind == AlertKind.NeedsTeacher)
                            {
                                @string.Format(culture, L["Alert_NeedsTeacher"], Methods(a.Detail))
                            }
                            else
                            {
                                @string.Format(culture, L["Alert_Recurring"], Misconceptions.Describe(a.Detail ?? "", d.Subject.Key, language))
                            }
                        </p>
                        <p class="mt-1 text-xs text-muted-foreground">@a.CreatedAt.ToLocalTime().ToString("g", culture)</p>
                    </div>
                    <form method="post" asp-page-handler="Resolve" asp-route-id="@d.Classroom.Id" asp-route-alert="@a.Id" class="shrink-0">
                        <button type="submit" class="@Ui.BtnLight py-1.5">@L["Alert_Resolve"]</button>
                    </form>
                </li>
            }
        </ul>
        <p class="px-4 md:px-5 py-3 border-t border-card-divider text-xs text-muted-foreground-1">@L["Alerts_Hint"]</p>
    </section>


</div>

<aside class="xl:col-span-4 space-y-4 sm:space-y-5 min-w-0">
    <section class="@Ui.Card p-5" aria-labelledby="concepts-title">
        <h2 id="concepts-title" class="text-base font-semibold text-foreground">@L["Panel_Concepts"]</h2>
        <ul class="mt-4 space-y-3.5">
            @foreach (var c in report.Concepts)
            {
                var avg = c.Average is { } v ? (int)Math.Round(v * 100) : 0;
                <li>
                    <div class="flex items-center justify-between gap-3 text-sm">
                        <span class="flex items-center gap-x-2.5 min-w-0"><span class="size-7 shrink-0 grid place-items-center rounded-lg text-[11px] font-bold @Ui.HeatClass(c.Average)">@(c.Mastered)</span><span class="truncate text-foreground">@c.Name</span></span>
                        <span class="shrink-0 text-xs font-semibold text-muted-foreground-1">@(c.Average is null ? "–" : $"{avg} %")</span>
                    </div>
                    <div class="mt-1.5 ms-9.5 h-1.5 rounded-full bg-surface overflow-hidden"><div class="h-full rounded-full bar-solid" style="width:@(avg)%"></div></div>
                </li>
            }
        </ul>
        <p class="mt-4 text-xs text-muted-foreground-1">@L["Panel_ConceptsHint"]</p>
    </section>

    <section class="@Ui.Card p-5" aria-labelledby="students-title">
        <h2 id="students-title" class="text-base font-semibold text-foreground">@L["Panel_Students"]</h2>
        <ul class="mt-3 divide-y divide-card-divider">
            @foreach (var r in report.Rows)
            {
                <li class="py-3 flex items-center gap-3">
                    <span class="size-10 shrink-0 grid place-items-center rounded-full text-xs font-bold text-foreground @Ui.AvatarTone(r.Name)">@Ui.Initials(r.Name)</span>
                    <div class="min-w-0 grow">
                        <p class="text-sm font-semibold text-foreground truncate">@r.Name</p>
                        <div class="mt-1 flex flex-wrap gap-1">
                            @if (r.AtRisk)
                            {
                                <span class="@Ui.Pill bg-primary text-primary-foreground">@L["Heat_AtRisk"]</span>
                            }
                            <span class="@Ui.Pill bg-surface text-foreground">@string.Format(culture, L["Panel_Mastered"], r.Mastered, report.Concepts.Count)</span>
                        </div>
                    </div>
                    <a href="/Teacher/Class?id=@d.Classroom.Id&student=@r.StudentId#student" class="@Ui.IconBtn size-8" title="@string.Format(culture, L["History_Student"], r.Name)" aria-label="@string.Format(culture, L["History_Student"], r.Name)">
                        <svg class="size-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 3v5h5" /><path d="M3.05 13A9 9 0 1 0 6 5.3L3 8" /><path d="M12 7v5l4 2" /></svg>
                    </a>
                </li>
            }
        </ul>
    </section>
    <section class="@Ui.Card min-w-0" aria-labelledby="mistakes-title">
        <div class="@Ui.CardHeader"><h2 id="mistakes-title" class="text-base font-semibold text-foreground">@L["Mistakes_Title"]</h2></div>
        @if (report.Misconceptions.Count == 0)
        {
            <p class="p-4 md:p-5 text-sm text-muted-foreground-1">@L["Mistakes_None"]</p>
        }
        <ol class="divide-y divide-card-divider">
            @foreach (var m in report.Misconceptions)
            {
                <li class="p-4 md:px-5 text-sm">
                    <div class="flex items-start justify-between gap-3">
                        <p class="text-foreground">@Misconceptions.Describe(m.Code, d.Subject.Key, language)</p>
                        <span class="shrink-0 text-xs text-muted-foreground-1">@string.Format(culture, m.Students == 1 ? L["Mistakes_Count_One"] : L["Mistakes_Count"], m.Count, m.Students)</span>
                    </div>
                    <p class="mt-1 text-xs text-muted-foreground-1">@ConceptName(m.ConceptKey)</p>
                </li>
            }
        </ol>
        <p class="px-4 md:px-5 py-3 border-t border-card-divider text-xs text-muted-foreground-1">@L["Mistakes_Hint"]</p>
    </section>
</aside>
</div>




@if (Model.Student is { } s)
{
    <section id="student" class="@Ui.Card min-w-0 scroll-mt-20" aria-labelledby="student-title">
        <div class="@Ui.CardHeader">
            <h2 id="student-title" class="text-base font-semibold text-foreground">@string.Format(culture, L["History_Student"], s.Name)</h2>
            <a href="/Teacher/Class?id=@d.Classroom.Id" class="text-sm text-primary hover:underline">@L["Close"]</a>
        </div>
        @if (s.Attempts.Count == 0)
        {
            <p class="p-4 md:p-5 text-sm text-muted-foreground-1">@L["History_None"]</p>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="min-w-full text-sm">
                    <thead><tr class="border-b border-card-divider text-xs text-muted-foreground-1">
                        <th scope="col" class="py-2 px-4 text-start font-medium">@L["History_When"]</th>
                        <th scope="col" class="py-2 px-4 text-start font-medium">@L["History_Concept"]</th>
                        <th scope="col" class="py-2 px-4 text-start font-medium">@L["History_Question"]</th>
                        <th scope="col" class="py-2 px-4 text-start font-medium">@L["History_Answer"]</th>
                        <th scope="col" class="py-2 px-4 text-start font-medium">@L["History_Method"]</th>
                    </tr></thead>
                    <tbody class="divide-y divide-card-divider">
                        @foreach (var a in s.Attempts)
                        {
                            <tr>
                                <td class="py-2 px-4 whitespace-nowrap text-muted-foreground-1">@a.At.ToLocalTime().ToString("g", culture)</td>
                                <td class="py-2 px-4 whitespace-nowrap">@ConceptName(a.ConceptKey)</td>
                                <td class="py-2 px-4 min-w-64 text-foreground">@a.Question</td>
                                <td class="py-2 px-4 whitespace-nowrap">
                                    <span class="@(a.Correct ? "text-teal-700 dark:text-teal-300" : "text-red-700 dark:text-red-300") font-medium">@(a.Correct ? "✓" : "✗") @a.Answer</span>
                                    @if (a.Misconception is { } code)
                                    {
                                        <span class="block text-xs text-muted-foreground-1">@Misconceptions.Humanize(code)</span>
                                    }
                                </td>
                                <td class="py-2 px-4 whitespace-nowrap text-muted-foreground-1">@(a.Diagnostic ? L["History_Diagnostic"] : L[$"Method_{a.Method}"])</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
}

@section Scripts {
    <script src="~/js/common.js" asp-append-version="true"></script>
    <script>Edu.copyButtons(document);</script>
}
