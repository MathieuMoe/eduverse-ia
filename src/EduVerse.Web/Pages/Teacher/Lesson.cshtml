@page
@model EduVerse.Web.Pages.Teacher.LessonModel
@{
    ViewData["Title"] = L["Nav_Lesson"];
    Stage[] stages = Enum.GetValues<Stage>();
}
<div class="flex flex-wrap justify-between items-end gap-3">
    <div class="min-w-0">
        <h1 class="text-2xl font-semibold text-foreground">@L["Lesson_Heading"]</h1>
        <p class="mt-1 text-sm text-muted-foreground-1 max-w-3xl">@L["Lesson_Subtitle"]</p>
    </div>
    <button type="button" id="ls-sample" class="@Ui.BtnLight">@L["Sample_Button"]</button>
</div>

<div class="grid xl:grid-cols-12 gap-4 sm:gap-6 items-start">
    <section class="@Ui.Card min-w-0 xl:col-span-5" aria-labelledby="ls-form-title">
        <div class="@Ui.CardHeader"><h2 id="ls-form-title" class="text-base font-semibold text-foreground">@L["Lesson_Source"]</h2>
            <label class="text-sm font-medium text-primary hover:underline cursor-pointer">@L["Lesson_Upload"]<input id="ls-file" type="file" accept=".pdf,.txt,.md,application/pdf,text/plain" class="sr-only" /></label></div>
        <form id="ls-form" class="p-4 md:p-5 space-y-4">
            <div class="grid sm:grid-cols-2 gap-4">
                <div><label class="@Ui.Label" for="ls-title">@L["Lesson_Title"]</label><input id="ls-title" class="@Ui.Input" maxlength="150" /></div>
                <div><label class="@Ui.Label" for="ls-subject">@L["Lesson_SubjectField"]</label><input id="ls-subject" class="@Ui.Input" maxlength="100" /></div>
                <div><label class="@Ui.Label" for="ls-stage">@L["Field_Stage"]</label>
                    <select id="ls-stage" class="@Ui.Input">@foreach (var s in stages) { <option value="@s" selected="@(s == Stage.Secondary)">@L[$"Stage_{s}"]</option> }</select></div>
                <div class="grid grid-cols-[1fr_5rem] gap-3">
                    <div><label class="@Ui.Label" for="ls-language">@L["Field_Language"]</label>
                        <select id="ls-language" class="@Ui.Input">@foreach (var l in Enum.GetValues<TeachLanguage>()) { <option value="@l" selected="@(l == Model.DefaultLanguage)">@L[$"Language_{l}"]</option> }</select></div>
                    <div><label class="@Ui.Label" for="ls-questions">@L["Lesson_Questions"]</label><input id="ls-questions" type="number" min="2" max="8" value="4" class="@Ui.Input" /></div>
                </div>
            </div>
            <div>
                <label class="@Ui.Label" for="ls-text">@L["Lesson_Text"]</label>
                <textarea id="ls-text" rows="12" maxlength="15000" class="@Ui.Input" placeholder="@L["Lesson_TextPlaceholder"]"></textarea>
                <p class="mt-1 text-xs text-muted-foreground-1" id="ls-count"></p>
            </div>
            <div class="flex flex-wrap items-center gap-3">
                <button type="submit" id="ls-submit" class="@Ui.BtnPrimary">@Html.Raw(Ui.Sparkle) @L["Lesson_Submit"]</button>
                <p id="ls-error" class="hidden text-sm text-red-600" role="alert"></p>
            </div>
        </form>
        <div class="px-4 md:px-5 pb-4">
            <h3 class="text-xs font-semibold uppercase text-muted-foreground-1">@L["History_Title"]</h3>
            <ul id="ls-history" class="mt-2 space-y-1 text-sm"></ul>
        </div>
    </section>

    <section id="ls-result" class="@Ui.Card min-w-0 xl:col-span-7" aria-live="polite" tabindex="-1">
        <div class="p-8 text-center" id="ls-empty">
            <svg class="mx-auto size-10 text-muted-foreground" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 20h20" /><rect x="3" y="12" width="4" height="8" rx="1" /><rect x="10" y="8" width="4" height="12" rx="1" /><rect x="17" y="4" width="4" height="16" rx="1" /></svg>
            <h2 class="mt-3 font-semibold text-foreground">@L["Lesson_EmptyTitle"]</h2>
            <p class="mt-1 text-sm text-muted-foreground-1">@L["Lesson_EmptyText"]</p>
        </div>
        <div id="ls-notice" class="hidden m-4 mb-0 p-3 rounded-lg text-sm bg-amber-50 text-amber-800 dark:bg-amber-500/15 dark:text-amber-300" role="status"></div>
        <div id="ls-body" class="hidden"></div>
    </section>
</div>

@section Scripts {
    <script src="~/js/common.js" asp-append-version="true"></script>
    <script src="~/js/lesson.js" asp-append-version="true"></script>
}
