@model EduVerse.Core.Ideas.IdeaKind
@* Ideas of the students: propose (a figure, an adventure world, a trade, a hobby) and vote for the ideas approved by an adult.
   Kept as a small round icon so it does not compete for space with the page's own content; its form and list open in a dropdown. *@
@{
    var kind = Model.ToString();
}
<div class="hs-dropdown [--placement:bottom-right] [--auto-close:outside] relative inline-flex" data-ideas="@kind" data-testid="ideas-@kind" id="ideas">
    <button type="button" class="hs-dropdown-toggle @Ui.IconBtn" aria-haspopup="dialog" aria-expanded="false" aria-label="@L[$"Ideas_Title_{kind}"]" title="@L[$"Ideas_Title_{kind}"]" data-testid="ideas-toggle-@kind">
        <span aria-hidden="true">💡</span>
    </button>
    <div class="hs-dropdown-menu transition-[opacity,margin] duration hs-dropdown-open:opacity-100 opacity-0 hidden w-[min(92vw,26rem)] z-50 bg-dropdown border border-layer-line shadow-xl rounded-2xl p-4 md:p-5" role="dialog" aria-label="@L[$"Ideas_Title_{kind}"]" data-testid="ideas-menu-@kind">
        <div class="min-w-0">
            <h2 class="text-base font-semibold text-foreground">💡 @L[$"Ideas_Title_{kind}"]</h2>
            <p class="text-xs text-muted-foreground-1">@L["Ideas_Subtitle"]</p>
        </div>
        <div class="mt-3 grid gap-5">
            <form class="space-y-3" data-idea-form novalidate>
                <div>
                    <label class="@Ui.Label" for="idea-text-@kind">@L[$"Ideas_Ask_{kind}"]</label>
                    <input id="idea-text-@kind" name="text" class="@Ui.Input" maxlength="@EduVerse.Core.Ideas.IdeaRules.MaxLength" required autocomplete="off"
                           placeholder="@L[$"Ideas_Placeholder_{kind}"]" data-testid="idea-text-@kind" />
                </div>
                <div>
                    <label class="@Ui.Label" for="idea-reason-@kind">@L["Ideas_Reason"]</label>
                    <input id="idea-reason-@kind" name="reason" class="@Ui.Input" maxlength="@EduVerse.Core.Ideas.IdeaRules.MaxReason" autocomplete="off" placeholder="@L["Ideas_ReasonPlaceholder"]" />
                </div>
                <div class="flex flex-wrap items-center gap-3">
                    <button type="submit" class="@Ui.BtnPrimary" data-testid="idea-send-@kind">💡 @L["Ideas_Send"]</button>
                    <p class="text-sm text-foreground" role="status" aria-live="polite" data-idea-status></p>
                </div>
                <p class="text-xs text-muted-foreground-1">🔒 @L["Ideas_Privacy"]</p>
            </form>
            <div class="min-w-0">
                <h3 class="text-sm font-semibold text-foreground">🗳️ @L["Ideas_Top"]</h3>
                <ul class="mt-2 space-y-2 max-h-64 overflow-y-auto" data-idea-list data-testid="idea-list-@kind"><li class="text-sm text-muted-foreground-1">…</li></ul>
            </div>
        </div>
    </div>
</div>
