@{
    var current = ViewContext.RouteData.Values["page"]?.ToString();
    var culture = Localization.CurrentCulture;
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
    var engine = EngineSelection.Current(Context, Engines);
    string EngineLabel(EduVerse.Infrastructure.Engines.AiEngine e) => e.IsDemo ? L["Engine_Demo"].Value : e.Name;
    var jsStrings = System.Text.Json.JsonSerializer.Serialize(
        L.GetAllStrings().Where(s => s.Name.StartsWith("Js_", StringComparison.Ordinal)).ToDictionary(s => s.Name[3..], s => s.Value));
    var user = Context.User;
    var signedIn = user.Identity?.IsAuthenticated == true;
    var isTeacherCompanion = user.IsTeacher();
    var displayName = signedIn ? user.DisplayName() : "";
    string Svg(string paths, string size = "size-[18px]") => $"<svg class=\"shrink-0 {size}\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\">{paths}</svg>";

    var nav = new List<(string Page, string Href, string Label, string Icon)>();
    if (user.IsStudent() && user.IsKid())
    {
        // A young child (EarlyYears/Primary1) gets 3 stops, not the 19-item menu built for an older student
        // managing their own study plan: the rest (Teach, Interview, Writing, a marketplace of tutors...) means
        // nothing at that age and is simply not offered, rather than shown and disabled.
        nav.Add(("/Student/Index", "/Student", L["Nav_StudentHome"], "<path d=\"m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z\"/><path d=\"M9 22V12h6v10\"/>"));
        nav.Add(("/Student/Explore", "/Student/Explore", L["Nav_Explore"], "<circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"m16.24 7.76-2.12 6.36-6.36 2.12 2.12-6.36z\"/>"));
        nav.Add(("/Student/Achievements", "/Student/Achievements", L["Nav_Achievements"], "<circle cx=\"12\" cy=\"8\" r=\"6\"/><path d=\"M15.48 12.89 17 22l-5-3-5 3 1.52-9.11\"/>"));
    }
    else if (user.IsStudent())
    {
        nav.Add(("/Student/Index", "/Student", L["Nav_StudentHome"], "<path d=\"m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z\"/><path d=\"M9 22V12h6v10\"/>"));
        nav.Add(("/Student/Explore", "/Student/Explore", L["Nav_Explore"], "<circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"m16.24 7.76-2.12 6.36-6.36 2.12 2.12-6.36z\"/>"));
        nav.Add(("/Student/Learn", "/Student/Learn", L["Nav_Learn"], "<path d=\"M22 10v6M2 10l10-5 10 5-10 5z\"/><path d=\"M6 12v5c3 3 9 3 12 0v-5\"/>"));
        nav.Add(("/Student/Adventures", "/Student/Adventures", L["Nav_Adventures"], "<path d=\"M14.106 5.553a2 2 0 0 0 1.788 0l3.659-1.83A1 1 0 0 1 21 4.619v12.764a1 1 0 0 1-.553.894l-4.553 2.277a2 2 0 0 1-1.788 0l-4.212-2.106a2 2 0 0 0-1.788 0l-3.659 1.83A1 1 0 0 1 3 19.381V6.618a1 1 0 0 1 .553-.894l4.553-2.277a2 2 0 0 1 1.788 0z\"/><path d=\"M15 5.764v15M9 3.236v15\"/>"));
        nav.Add(("/Student/Teach", "/Student/Teach", L["Nav_Teach"], "<path d=\"M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z\"/><path d=\"M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z\"/>"));
        nav.Add(("/Student/Interview", "/Student/Interview", L["Nav_Interview"], "<path d=\"M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z\"/><path d=\"M19 10v2a7 7 0 0 1-14 0v-2M12 19v3\"/>"));
        nav.Add(("/Student/Arena", "/Student/Arena", L["Nav_Arena"], "<path d=\"M6 9H4.5a2.5 2.5 0 0 1 0-5H6M18 9h1.5a2.5 2.5 0 0 0 0-5H18M4 22h16M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22\"/><path d=\"M18 2H6v7a6 6 0 0 0 12 0V2Z\"/>"));
        nav.Add(("/Student/History", "/Student/History", L["Nav_History"], "<path d=\"M3 12a9 9 0 1 0 3-6.7L3 8\"/><path d=\"M3 3v5h5M12 7v5l4 2\"/>"));
        nav.Add(("/Student/Achievements", "/Student/Achievements", L["Nav_Achievements"], "<circle cx=\"12\" cy=\"8\" r=\"6\"/><path d=\"M15.48 12.89 17 22l-5-3-5 3 1.52-9.11\"/>"));
        nav.Add(("/Student/Learner", "/Student/Learner", L["Nav_Learner"], "<circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"m16.24 7.76-1.8 5.4a2 2 0 0 1-1.27 1.27l-5.4 1.8 1.8-5.4a2 2 0 0 1 1.27-1.27z\"/>"));
        nav.Add(("/Student/Journey", "/Student/Journey", L["Nav_Journey"], "<circle cx=\"12\" cy=\"12\" r=\"10\"/><polygon points=\"16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88\"/>"));
        nav.Add(("/Student/Plan", "/Student/Plan", L["Nav_Plan"], "<circle cx=\"12\" cy=\"12\" r=\"10\"/><circle cx=\"12\" cy=\"12\" r=\"6\"/><circle cx=\"12\" cy=\"12\" r=\"2\"/>"));
        nav.Add(("/Student/Homework", "/Student/Homework", L["Nav_Homework"], "<path d=\"M4 19.5A2.5 2.5 0 0 1 6.5 17H20\"/><path d=\"M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z\"/>"));
        nav.Add(("/Student/Pip", "/Student/Pip", L["Nav_Pip"], "<path d=\"M4 19.5A2.5 2.5 0 0 1 6.5 17H20\"/><path d=\"M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z\"/>"));
        nav.Add(("/Student/Fading", "/Student/Fading", L["Nav_Fading"], "<path d=\"M4 19.5A2.5 2.5 0 0 1 6.5 17H20\"/><path d=\"M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z\"/>"));
        nav.Add(("/Student/Writing", "/Student/Writing", L["Nav_Writing"], "<path d=\"M4 19.5A2.5 2.5 0 0 1 6.5 17H20\"/><path d=\"M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z\"/>"));
        nav.Add(("/Student/Materials", "/Student/Materials", L["Nav_Materials"], "<path d=\"M4 19.5A2.5 2.5 0 0 1 6.5 17H20\"/><path d=\"M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z\"/>"));
        nav.Add(("/Student/Letter", "/Student/Letter", L["Nav_Letter"], "<path d=\"M4 19.5A2.5 2.5 0 0 1 6.5 17H20\"/><path d=\"M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z\"/>"));
        nav.Add(("/Student/NewSubject", "/Student/NewSubject", L["Nav_NewSubject"], "<path d=\"M12 5v14M5 12h14\"/>"));
        nav.Add(("/Marketplace/Index", "/Marketplace", L["Nav_Marketplace"], "<path d=\"M3 9l1-5h16l1 5\"/><path d=\"M4 9v11h16V9\"/><path d=\"M3 9a3 3 0 0 0 6 0 3 3 0 0 0 6 0 3 3 0 0 0 6 0\"/><path d=\"M9 20v-6h6v6\"/>"));
        nav.Add(("/Marketplace/Bookings", "/Marketplace/Bookings", L["Nav_MyLessons"], "<rect x=\"3\" y=\"4\" width=\"18\" height=\"18\" rx=\"2\"/><path d=\"M16 2v4M8 2v4M3 10h18M9 15l2 2 4-4\"/>"));
    }
    else if (user.IsDirector())
    {
        nav.Add(("/Institution/Index", "/Institution", L["Nav_Institution"], "<path d=\"M3 21h18M5 21V7l7-4 7 4v14\"/><path d=\"M9 21v-4h6v4M9 10h.01M15 10h.01M9 14h.01M15 14h.01\"/>"));
        nav.Add(("/Institution/Risk", "/Institution/Risk", L["Nav_Risk"], "<path d=\"M12 9v4M12 17h.01\"/><path d=\"M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z\"/>"));
        nav.Add(("/Institution/Quality", "/Institution/Quality", L["Nav_Quality"], "<path d=\"M12 2 15 8.5 22 9.3 17 14 18.2 21 12 17.8 5.8 21 7 14 2 9.3 9 8.5z\"/>"));
        nav.Add(("/Moderation/Ideas", "/Moderation", L["Nav_Ideas"], "<path d=\"M9 18h6M10 22h4\"/><path d=\"M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.65 0 0 0 18 8 6 6 0 0 0 6 8c0 1 .23 2.23 1.5 3.5A4.61 4.61 0 0 1 8.91 14\"/>"));
    }
    else if (user.IsTutor())
    {
        nav.Add(("/Tutor/Index", "/Tutor", L["Nav_TutorHome"], "<path d=\"m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z\"/><path d=\"M9 22V12h6v10\"/>"));
        nav.Add(("/Tutor/Profile", "/Tutor/Profile", L["Nav_TutorProfile"], "<circle cx=\"12\" cy=\"8\" r=\"4\"/><path d=\"M4 21a8 8 0 0 1 16 0\"/>"));
        nav.Add(("/Marketplace/Index", "/Marketplace", L["Nav_Marketplace"], "<path d=\"M3 9l1-5h16l1 5\"/><path d=\"M4 9v11h16V9\"/><path d=\"M3 9a3 3 0 0 0 6 0 3 3 0 0 0 6 0 3 3 0 0 0 6 0\"/><path d=\"M9 20v-6h6v6\"/>"));
    }
    else if (user.IsTeacher())
    {
        nav.Add(("/Teacher/Index", "/Teacher", L["Nav_Classes"], "<path d=\"M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2\"/><circle cx=\"9\" cy=\"7\" r=\"4\"/><path d=\"M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75\"/>"));
        nav.Add(("/Teacher/Pack", "/Teacher/Pack", L["Nav_Pack"], "<path d=\"M21 8 12 3 3 8l9 5 9-5z\"/><path d=\"m3 13 9 5 9-5M3 18l9 5 9-5\"/>"));
        nav.Add(("/Teacher/Lesson", "/Teacher/Lesson", L["Nav_Lesson"], "<path d=\"M2 20h20\"/><rect x=\"3\" y=\"12\" width=\"4\" height=\"8\" rx=\"1\"/><rect x=\"10\" y=\"8\" width=\"4\" height=\"12\" rx=\"1\"/><rect x=\"17\" y=\"4\" width=\"4\" height=\"16\" rx=\"1\"/>"));
        nav.Add(("/Teacher/Summary", "/Teacher/Summary", L["Nav_Summary"], "<path d=\"M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z\"/><path d=\"M14 2v6h6M8 13h8M8 17h5\"/>"));
        nav.Add(("/Moderation/Ideas", "/Moderation", L["Nav_Ideas"], "<path d=\"M9 18h6M10 22h4\"/><path d=\"M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.65 0 0 0 18 8 6 6 0 0 0 6 8c0 1 .23 2.23 1.5 3.5A4.61 4.61 0 0 1 8.91 14\"/>"));
    }
    else
    {
        nav.Add(("/Index", "/", L["Nav_Home"], "<path d=\"m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z\"/>"));
        nav.Add(("/Account/Login", "/Account/Login", L["Nav_Login"], "<path d=\"M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4M10 17l5-5-5-5M15 12H3\"/>"));
        nav.Add(("/Marketplace/Index", "/Marketplace", L["Nav_Marketplace"], "<path d=\"M3 9l1-5h16l1 5\"/><path d=\"M4 9v11h16V9\"/><path d=\"M3 9a3 3 0 0 0 6 0 3 3 0 0 0 6 0 3 3 0 0 0 6 0\"/><path d=\"M9 20v-6h6v6\"/>"));
        nav.Add(("/Account/Register", "/Account/Register", L["Nav_Register"], "<path d=\"M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2\"/><circle cx=\"9\" cy=\"7\" r=\"4\"/><path d=\"M19 8v6M22 11h-6\"/>"));
    }
    nav.Add(("/About", "/About", L["Nav_About"], "<circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"M12 16v-4M12 8h.01\"/>"));

    (string Href, string Name, string Icon)[] resources =
    [
        ("https://github.com/MathieuMoe/eduverse-ia", L["Nav_SourceCode"], "<path d=\"M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20\"/>"),
        ("https://github.com/MathieuMoe/ai-teacher-assistant", "MatGPT Teacher", "<path d=\"M2 20h20\"/><rect x=\"3\" y=\"12\" width=\"4\" height=\"8\" rx=\"1\"/><rect x=\"10\" y=\"8\" width=\"4\" height=\"12\" rx=\"1\"/><rect x=\"17\" y=\"4\" width=\"4\" height=\"16\" rx=\"1\"/>"),
        ("https://github.com/MathieuMoe/education-assistant", "MatGPT Director", "<circle cx=\"12\" cy=\"12\" r=\"10\"/><circle cx=\"12\" cy=\"12\" r=\"6\"/><circle cx=\"12\" cy=\"12\" r=\"2\"/>"),
        ("https://github.com/MathieuMoe/ai-study-tutor", "MatGPT Tutor", "<path d=\"M7.9 20A9 9 0 1 0 4 16.1L2 22Z\"/>"),
        ("https://github.com/MathieuMoe/ai-quiz-generator", "MatGPT Quiz", "<path d=\"M9 11l3 3L22 4\"/><path d=\"M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11\"/>"),
        ("https://github.com/MathieuMoe/ai-oral-exam-simulator", "MatGPT Simulador", "<path d=\"M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z\"/><path d=\"M19 10v2a7 7 0 0 1-14 0v-2M12 19v3\"/>"),
        ("https://github.com/MathieuMoe/ai-study-planner", "MatGPT StudyPlan", "<rect x=\"3\" y=\"4\" width=\"18\" height=\"18\" rx=\"2\"/><path d=\"M16 2v4M8 2v4M3 10h18\"/>"),
        ("https://github.com/MathieuMoe/ai-syllabus-builder", "MatGPT Temario", "<path d=\"M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z\"/><path d=\"M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z\"/>"),
    ];

    const string navLink = "group/nav flex items-center gap-x-3 p-1.5 pe-3 rounded-2xl text-sm font-medium text-sidebar-nav-foreground hover:bg-sidebar-nav-hover focus:outline-hidden focus-visible:ring-2 focus-visible:ring-primary/30 lg:sb-collapsed:justify-center lg:sb-collapsed:pe-1.5";
    const string navLabel = "truncate lg:sb-collapsed:sr-only";
    const string menuItem = "flex items-center justify-between gap-x-3 py-2 px-3 rounded-xl text-sm text-dropdown-item-foreground hover:bg-dropdown-item-hover focus:outline-hidden focus:bg-dropdown-item-focus";
    const string segment = "flex-1 py-1.5 px-2 rounded-lg text-xs font-semibold text-muted-foreground-1 hover:text-foreground aria-pressed:bg-layer aria-pressed:text-foreground aria-pressed:shadow-2xs";
}
<!DOCTYPE html>
<html lang="@culture" class="relative min-h-full">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · EduVerse AI</title>
    <link rel="icon" href="~/img/logo.svg" type="image/svg+xml" />
    <script>
        // Apply the saved theme and interface preferences before the first paint (no flash)
        (() => {
            try {
                const d = document.documentElement;
                const ui = JSON.parse(localStorage.getItem("ev_ui") || "{}");
                const t = localStorage.getItem("hs_theme");
                if (t === "dark" || ((!t || t === "auto") && matchMedia("(prefers-color-scheme: dark)").matches)) d.classList.add("dark");
                if (ui.sidebar === "collapsed") d.classList.add("sb-collapsed");
                if (ui.accent && ui.accent !== "plum") d.dataset.accent = ui.accent;
                if (ui.text === "s") d.style.fontSize = "15px";
                if (ui.text === "l") d.style.fontSize = "17.5px";
                if (ui.motion === "reduce") d.classList.add("reduce-motion");
                if (ui.focus && location.pathname.toLowerCase().startsWith("/student/learn")) d.classList.add("focus-mode");
            } catch { }
        })();
    </script>
    <link rel="preload" href="~/lib/urbanist/urbanist-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="text-foreground antialiased min-h-screen">

    <!-- ========== HEADER ========== -->
    <header class="sticky top-0 inset-x-0 z-48 w-full lg:ps-[17.25rem] lg:sb-collapsed:ps-[6.5rem] lg:focus-mode:ps-3! transition-[padding] duration-300">
        <nav class="mx-3 mt-3 px-3 sm:px-4 h-16 flex items-center justify-between gap-x-2 sm:gap-x-3 rounded-3xl bg-card border border-card-line glass shadow-[0_12px_40px_-20px_rgb(53_43_56/0.25)] dark:shadow-none">
            <div class="flex items-center gap-x-2 min-w-0 shrink">
                <button type="button" class="lg:hidden @Ui.IconBtn" aria-haspopup="dialog" aria-expanded="false" aria-controls="hs-application-sidebar" aria-label="@L["Nav_OpenMenu"]" data-hs-overlay="#hs-application-sidebar">
                    @Html.Raw(Svg("<line x1=\"4\" x2=\"20\" y1=\"6\" y2=\"6\"/><line x1=\"4\" x2=\"20\" y1=\"12\" y2=\"12\"/><line x1=\"4\" x2=\"20\" y1=\"18\" y2=\"18\"/>", "size-4"))
                </button>
                <button type="button" class="max-lg:hidden! @Ui.IconBtn tip tip-b" data-ui-toggle="sidebar" aria-label="@L["Nav_ToggleSidebar"]" data-tip="@L["Nav_ToggleSidebar"] ( [ )">
                    @Html.Raw(Svg("<rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"3\"/><path d=\"M9 3v18\"/><path class=\"sb-collapsed:hidden\" d=\"m16 15-3-3 3-3\"/><path class=\"hidden sb-collapsed:inline\" d=\"m14 9 3 3-3 3\"/>", "size-4"))
                </button>
                <div class="min-w-0 ps-1">
                    <p class="hidden sm:block text-xs text-muted-foreground-1 leading-tight">EduVerse AI</p>
                    <p class="font-semibold text-foreground truncate leading-tight" aria-current="page">@ViewData["Title"]</p>
                </div>
            </div>

            <!-- Quick navigation (Ctrl+K) -->
            <button type="button" data-palette-open class="hidden md:flex items-center gap-x-2 grow max-w-sm h-10 px-4 rounded-full border border-layer-line bg-layer/70 text-sm text-muted-foreground-1 hover:bg-layer focus:outline-hidden focus-visible:ring-2 focus-visible:ring-primary/30" aria-label="@L["Palette_Open"]">
                @Html.Raw(Svg("<circle cx=\"11\" cy=\"11\" r=\"8\"/><path d=\"m21 21-4.3-4.3\"/>", "size-4"))
                <span class="grow text-start">@L["Palette_Placeholder"]</span>
                <kbd class="py-0.5 px-1.5 rounded-md border border-layer-line text-[11px] font-sans">Ctrl K</kbd>
            </button>

            <div class="flex items-center gap-x-1 sm:gap-x-2 shrink-0">
                <button type="button" data-palette-open class="md:hidden @Ui.IconBtn" aria-label="@L["Palette_Open"]">@Html.Raw(Svg("<circle cx=\"11\" cy=\"11\" r=\"8\"/><path d=\"m21 21-4.3-4.3\"/>", "size-4"))</button>

                @if (user.IsStudent() || user.IsTeacher())
                {
                    <!-- The Tutor of every page (student) / the class assistant (teacher) -->
                    <button type="button" id="companion-open" class="h-9 inline-flex items-center gap-x-1.5 ps-1 pe-2.5 sm:pe-3 rounded-full text-xs font-semibold border border-layer-line bg-layer text-foreground hover:bg-layer-hover focus:outline-hidden focus-visible:ring-2 focus-visible:ring-primary/30 tip tip-b"
                            aria-controls="companion" aria-expanded="false" data-tip="@L[isTeacherCompanion ? "TeacherCompanion_Open" : "Companion_Open"]" data-testid="companion-open">
                        <partial name="_Mascot" model="@("size-7")" />
                        <span class="max-sm:sr-only">@L[isTeacherCompanion ? "TeacherCompanion_Button" : "Companion_Button"]</span>
                    </button>
                }

                <!-- AI engine: Claude, ChatGPT, Gemini, Ollama or the demo -->
                <div class="hs-dropdown [--placement:bottom-right] relative inline-flex">
                    <button id="engine-menu" type="button" class="hs-dropdown-toggle h-9 inline-flex items-center gap-x-1.5 px-2.5 sm:px-3 rounded-full text-xs font-semibold border border-layer-line bg-layer text-foreground hover:bg-layer-hover focus:outline-hidden tip tip-b"
                            aria-haspopup="menu" aria-expanded="false" data-tip="@L["Nav_EngineTooltip"]">
                        <span class="size-2 rounded-full @(engine.IsDemo ? "bg-amber-500" : "bg-emerald-500")"></span>
                        <span class="max-w-28 truncate max-sm:sr-only">@EngineLabel(engine)</span>
                        @Html.Raw(Svg("<path d=\"m6 9 6 6 6-6\"/>", "size-3"))
                    </button>
                    <div class="hs-dropdown-menu transition-[opacity,margin] duration hs-dropdown-open:opacity-100 opacity-0 hidden min-w-60 z-50 bg-dropdown border border-layer-line shadow-xl rounded-2xl p-1.5" role="menu" aria-labelledby="engine-menu">
                        <p class="px-3 pt-2 pb-1 text-xs text-muted-foreground-1">@L["Engine_Choose"]</p>
                        @foreach (var e in Engines.All)
                        {
                            <a class="@menuItem @(e.Id == engine.Id ? "font-semibold" : "")" href="/engine/@e.Id?returnUrl=@Uri.EscapeDataString(returnUrl)">
                                <span class="flex items-center gap-x-2"><span class="size-2 rounded-full @(e.IsDemo ? "bg-amber-500" : "bg-emerald-500")"></span>@EngineLabel(e)</span>
                                @if (e.Id == engine.Id) { @Html.Raw(Svg("<path d=\"M20 6 9 17l-5-5\"/>", "size-4 text-primary")) }
                            </a>
                        }
                        <p class="px-3 pt-2 pb-2 text-xs text-muted-foreground-1 border-t border-card-divider mt-1">@L["Engine_Hint"]</p>
                    </div>
                </div>

                <!-- Interface language -->
                <div class="hs-dropdown [--placement:bottom-right] relative inline-flex">
                    <button id="lang-menu" type="button" class="hs-dropdown-toggle h-9 px-2.5 inline-flex items-center gap-x-1.5 rounded-full text-sm font-semibold text-foreground hover:bg-layer-hover focus:outline-hidden tip tip-b"
                            aria-haspopup="menu" aria-expanded="false" aria-label="@L["Nav_Language"]" data-tip="@L["Nav_Language"]">
                        @Html.Raw(Svg("<circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z\"/>", "size-4"))
                        <span class="uppercase max-sm:sr-only">@culture</span>
                    </button>
                    <div class="hs-dropdown-menu transition-[opacity,margin] duration hs-dropdown-open:opacity-100 opacity-0 hidden min-w-40 z-50 bg-dropdown border border-layer-line shadow-xl rounded-2xl p-1.5" role="menu" aria-orientation="vertical" aria-labelledby="lang-menu">
                        @foreach (var (code, name) in Localization.Cultures)
                        {
                            <a class="@menuItem @(code == culture ? "font-semibold" : "")" href="/culture/@code?returnUrl=@Uri.EscapeDataString(returnUrl)" lang="@code" hreflang="@code" data-palette-lang="@name">
                                @name
                                @if (code == culture) { @Html.Raw(Svg("<path d=\"M20 6 9 17l-5-5\"/>", "size-4 text-primary")) }
                            </a>
                        }
                    </div>
                </div>

                <!-- Display: sidebar, text size, theme, accent colour, motion -->
                <div class="hs-dropdown [--placement:bottom-right] [--auto-close:outside] relative inline-flex">
                    <button id="display-menu" type="button" class="hs-dropdown-toggle @Ui.IconBtn tip tip-b" aria-haspopup="menu" aria-expanded="false" aria-label="@L["Display_Title"]" data-tip="@L["Display_Title"]" data-testid="display-menu">
                        @Html.Raw(Svg("<path d=\"M20 7h-9M14 17H5\"/><circle cx=\"17\" cy=\"17\" r=\"3\"/><circle cx=\"7\" cy=\"7\" r=\"3\"/>", "size-4"))
                    </button>
                    <div class="hs-dropdown-menu transition-[opacity,margin] duration hs-dropdown-open:opacity-100 opacity-0 hidden w-72 z-50 bg-dropdown border border-layer-line shadow-xl rounded-2xl p-3 space-y-3" role="dialog" aria-labelledby="display-menu">
                        <p class="text-sm font-semibold text-foreground">@L["Display_Title"]</p>
                        <div class="hidden lg:block">
                            <p class="mb-1.5 text-xs text-muted-foreground-1">@L["Display_Sidebar"]</p>
                            <div class="flex gap-1 p-1 rounded-xl bg-surface">
                                <button type="button" class="@segment" data-ui="sidebar" data-value="expanded">@L["Display_Expanded"]</button>
                                <button type="button" class="@segment" data-ui="sidebar" data-value="collapsed">@L["Display_Collapsed"]</button>
                            </div>
                        </div>
                        <div>
                            <p class="mb-1.5 text-xs text-muted-foreground-1">@L["Display_TextSize"]</p>
                            <div class="flex gap-1 p-1 rounded-xl bg-surface">
                                <button type="button" class="@segment text-[11px]" data-ui="text" data-value="s" aria-label="@L["Display_TextSmall"]">A</button>
                                <button type="button" class="@segment text-sm" data-ui="text" data-value="m" aria-label="@L["Display_TextMedium"]">A</button>
                                <button type="button" class="@segment text-base" data-ui="text" data-value="l" aria-label="@L["Display_TextLarge"]">A</button>
                            </div>
                        </div>
                        <div>
                            <p class="mb-1.5 text-xs text-muted-foreground-1">@L["Display_Theme"]</p>
                            <div class="flex gap-1 p-1 rounded-xl bg-surface">
                                <button type="button" class="@segment" data-ui="theme" data-value="light">@L["Theme_Light"]</button>
                                <button type="button" class="@segment" data-ui="theme" data-value="dark">@L["Theme_Dark"]</button>
                                <button type="button" class="@segment" data-ui="theme" data-value="auto">@L["Theme_System"]</button>
                            </div>
                        </div>
                        <div>
                            <p class="mb-1.5 text-xs text-muted-foreground-1">@L["Display_Accent"]</p>
                            <div class="flex gap-2">
                                @foreach (var (accent, color) in new[] { ("plum", "#352b38"), ("indigo", "#4f46e5"), ("teal", "#0f766e"), ("rose", "#be185d"), ("blue", "#2563eb") })
                                {
                                    <button type="button" data-ui="accent" data-value="@accent" class="size-8 rounded-full ring-offset-2 ring-offset-dropdown aria-pressed:ring-2 aria-pressed:ring-foreground/60 focus:outline-hidden focus-visible:ring-2 tip" style="background:@color" aria-label="@L[$"Accent_{accent}"]" data-tip="@L[$"Accent_{accent}"]"></button>
                                }
                            </div>
                        </div>
                        <label class="flex items-center justify-between gap-3 text-sm text-foreground cursor-pointer">
                            @L["Display_ReduceMotion"]
                            <input type="checkbox" data-ui-check="motion" class="relative w-10 h-6 p-px bg-surface-1 border-transparent rounded-full cursor-pointer appearance-none transition-colors checked:bg-primary before:inline-block before:size-5 before:bg-white before:rounded-full before:shadow before:transition before:translate-x-0 checked:before:translate-x-4" />
                        </label>
                        <div class="flex items-center justify-between pt-2 border-t border-card-divider">
                            <span class="text-xs text-muted-foreground-1">@L["Display_Shortcuts"]</span>
                            <button type="button" data-ui-reset class="text-xs font-semibold text-primary hover:underline">@L["Display_Reset"]</button>
                        </div>
                    </div>
                </div>

                <button type="button" id="theme-toggle" class="@Ui.IconBtn tip tip-b" aria-label="@L["Nav_ToggleTheme"]" data-tip="@L["Nav_ToggleTheme"]">
                    @Html.Raw(Svg("<path d=\"M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z\"/>", "size-4 dark:hidden"))
                    @Html.Raw(Svg("<circle cx=\"12\" cy=\"12\" r=\"4\"/><path d=\"M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41\"/>", "size-4 hidden dark:block"))
                </button>
                <a href="https://github.com/MathieuMoe/eduverse-ia" class="max-md:hidden! @Ui.IconBtn tip tip-b" aria-label="GitHub" data-tip="GitHub">
                    <svg class="size-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.9-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.52 2.34 1.08 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02a9.6 9.6 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.74c0 .27.18.58.69.48A10 10 0 0 0 12 2z" /></svg>
                </a>
            </div>
        </nav>
    </header>

    <!-- ========== SIDEBAR (floating, collapsible to icons) ========== -->
    <aside id="hs-application-sidebar" role="dialog" tabindex="-1" aria-label="@L["Nav_Main"]"
           class="hs-overlay [--auto-close:lg] hs-overlay-open:translate-x-0 -translate-x-full transition-all duration-300 transform w-64 h-full hidden fixed inset-y-0 start-0 z-60 bg-sidebar border-e border-sidebar-line glass
                  lg:block lg:translate-x-0 lg:end-auto lg:inset-y-3 lg:start-3 lg:h-auto lg:rounded-3xl lg:border lg:shadow-[0_12px_40px_-18px_rgb(53_43_56/0.25)] lg:dark:shadow-none lg:sb-collapsed:w-[4.75rem] lg:focus-mode:hidden!">
        <div class="relative flex flex-col h-full max-h-full">
            <div class="px-4 h-16 flex items-center lg:sb-collapsed:justify-center lg:sb-collapsed:px-0">
                <a class="flex items-center gap-x-2.5 text-lg font-bold text-foreground focus:outline-hidden" href="@(signedIn ? user.Home() : "/")" aria-label="EduVerse AI">
                    <img src="~/img/logo.svg" alt="" class="size-9 rounded-xl" />
                    <span class="lg:sb-collapsed:sr-only">EduVerse <span class="text-primary">AI</span></span>
                </a>
            </div>

            <nav class="h-full overflow-y-auto overflow-x-hidden px-3 pb-4 [scrollbar-width:thin]">
                @if (signedIn)
                {
                    <span class="block mb-2 px-2 text-[11px] font-semibold uppercase tracking-wide text-muted-foreground-1 lg:sb-collapsed:sr-only">@(user.IsDirector() ? L["Nav_DirectorSpace"] : user.IsTutor() ? L["Nav_TutorSpace"] : user.IsTeacher() ? L["Nav_TeacherSpace"] : L["Nav_StudentSpace"])</span>
                }
                <ul class="flex flex-col gap-y-1">
                    @foreach (var item in nav)
                    {
                        var active = current == item.Page;
                        <li class="hs-tooltip [--trigger:hover] [--placement:right]">
                            <a class="hs-tooltip-toggle @navLink @(active ? "text-foreground font-semibold" : "")" href="@item.Href" data-nav aria-current="@(active ? "page" : null)">
                                <span class="size-9 shrink-0 grid place-items-center rounded-xl transition-colors @(active ? "bg-primary text-primary-foreground shadow-sm" : "bg-surface/70 group-hover/nav:bg-surface")">@Html.Raw(Svg(item.Icon))</span>
                                <span class="@navLabel">@item.Label</span>
                            </a>
                            <span class="hs-tooltip-content hs-tooltip-shown:opacity-100 hs-tooltip-shown:visible absolute hidden lg:sb-collapsed:block opacity-0 invisible transition-opacity duration-150 z-50 py-1.5 px-2.5 rounded-xl text-xs font-semibold whitespace-nowrap bg-primary text-primary-foreground shadow-lg" role="tooltip">@item.Label</span>
                        </li>
                    }
                </ul>

                @if (!user.IsKid())
                {
                    <span class="block mt-6 mb-2 px-2 text-[11px] font-semibold uppercase tracking-wide text-muted-foreground-1 lg:sb-collapsed:sr-only">@L["Nav_Resources"]</span>
                    <span class="hidden lg:sb-collapsed:block mx-auto my-4 w-6 border-t border-card-divider" aria-hidden="true"></span>
                    <ul class="flex flex-col gap-y-0.5">
                        @foreach (var (href, name, icon) in resources)
                        {
                            <li>
                                <a class="@navLink py-1 text-muted-foreground-1 hover:text-foreground tip" href="@href" data-tip="@name" data-nav>
                                    <span class="size-8 shrink-0 grid place-items-center rounded-xl">@Html.Raw(Svg(icon, "size-4"))</span>
                                    <span class="@navLabel">@name</span>
                                </a>
                            </li>
                        }
                    </ul>
                }
            </nav>

            @if (signedIn)
            {
                <div class="m-3 mt-0 p-2 rounded-2xl bg-surface/70 flex items-center justify-between gap-2 lg:sb-collapsed:flex-col lg:sb-collapsed:m-2 lg:sb-collapsed:px-1">
                    <span class="flex items-center gap-x-2.5 min-w-0">
                        <span class="size-9 shrink-0 grid place-items-center rounded-full bg-primary text-primary-foreground text-xs font-bold tip" data-tip="@displayName">@CurrentUser.Initials(displayName)</span>
                        <span class="text-sm leading-tight min-w-0 lg:sb-collapsed:sr-only">
                            <span class="block font-semibold text-foreground truncate" data-testid="user-name">@displayName</span>
                            <span class="block text-xs text-muted-foreground-1">@(user.IsDirector() ? L["Role_Director"] : user.IsTutor() ? L["Role_Tutor"] : user.IsTeacher() ? L["Role_Teacher"] : L["Role_Student"])</span>
                        </span>
                    </span>
                    <form method="post" action="/Account/Logout">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="size-8 inline-flex justify-center items-center rounded-full text-muted-foreground-1 hover:bg-layer hover:text-foreground tip" data-tip="@L["Nav_Logout"]" aria-label="@L["Nav_Logout"]" data-palette-logout>
                            @Html.Raw(Svg("<path d=\"M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9\"/>", "size-4"))
                        </button>
                    </form>
                </div>
            }
            else
            {
                <a href="https://www.linkedin.com/in/mathieu-moreau-045b26114/" class="m-3 mt-0 p-2 rounded-2xl flex items-center gap-x-2.5 hover:bg-sidebar-nav-hover focus:outline-hidden lg:sb-collapsed:justify-center tip" data-tip="Mathieu Moreau">
                    <span class="size-9 shrink-0 grid place-items-center rounded-full bg-surface text-xs font-bold text-foreground">MM</span>
                    <span class="text-sm leading-tight lg:sb-collapsed:sr-only">
                        <span class="block font-semibold text-foreground">Mathieu Moreau</span>
                        <span class="block text-xs text-muted-foreground-1">Full Stack .NET · UI/UX</span>
                    </span>
                </a>
            }
        </div>
    </aside>

    <!-- ========== CONTENT ========== -->
    <main class="w-full lg:ps-[17.25rem] lg:sb-collapsed:ps-[6.5rem] lg:focus-mode:ps-0! transition-[padding] duration-300">
        <div class="p-3 sm:p-6 lg:ps-3 space-y-6 w-full focus-mode:max-w-4xl focus-mode:mx-auto lg:focus-mode:ps-6">
            @{
                var crumbs = EduVerse.Web.Breadcrumb.For(ViewData, current, signedIn ? user.Home() : "/", L["Crumb_Home"], nav.Select(n => (n.Page, n.Href, n.Label)));
            }
            @if (crumbs is not null)
            {
                <partial name="_Breadcrumb" model="crumbs" />
            }
            @RenderBody()
        </div>
    </main>

    <!-- ========== QUICK NAVIGATION (Ctrl+K) ========== -->
    <div id="palette" class="hidden fixed inset-0 z-80 bg-black/30 backdrop-blur-sm p-4 pt-[12vh]" role="dialog" aria-modal="true" aria-label="@L["Palette_Open"]">
        <div class="mx-auto max-w-lg bg-dropdown border border-layer-line rounded-3xl shadow-2xl overflow-hidden">
            <div class="flex items-center gap-x-3 px-4 border-b border-card-divider">
                @Html.Raw(Svg("<circle cx=\"11\" cy=\"11\" r=\"8\"/><path d=\"m21 21-4.3-4.3\"/>", "size-4 text-muted-foreground-1"))
                <input id="palette-input" class="w-full h-14 bg-transparent border-0 text-base text-foreground placeholder:text-muted-foreground focus:ring-0 focus:outline-hidden" placeholder="@L["Palette_Placeholder"]" autocomplete="off" role="combobox" aria-controls="palette-list" aria-expanded="true" />
                <kbd class="py-0.5 px-1.5 rounded-md border border-layer-line text-[11px] text-muted-foreground-1">Esc</kbd>
            </div>
            <ul id="palette-list" class="max-h-80 overflow-y-auto p-2" role="listbox"></ul>
        </div>
    </div>

    @if (user.IsStudent() || user.IsTeacher())
    {
        <aside id="companion" class="fixed inset-y-0 end-0 z-[70] w-full sm:w-[26rem] flex flex-col bg-layer border-s border-layer-line shadow-2xl" role="dialog" aria-modal="false" aria-labelledby="companion-title" hidden data-testid="companion" data-api="@(isTeacherCompanion ? "/api/teacher-companion" : "/api/companion")">
            <header class="flex items-center gap-3 p-4 border-b border-card-divider">
                <partial name="_Mascot" model="@("size-11 shrink-0")" />
                <div class="min-w-0 grow">
                    <h2 id="companion-title" class="font-semibold text-foreground">@L[isTeacherCompanion ? "TeacherCompanion_Title" : "Companion_Title"]</h2>
                    <p class="text-xs text-muted-foreground-1">@L[isTeacherCompanion ? "TeacherCompanion_Subtitle" : "Companion_Subtitle"]</p>
                </div>
                <button type="button" id="companion-speak" class="@Ui.IconBtn tip tip-b" aria-pressed="false" data-tip="@L["Quiz_ReadAloud"]" aria-label="@L["Quiz_ReadAloud"]">🔈</button>
                <button type="button" id="companion-clear" class="@Ui.IconBtn tip tip-b" data-tip="@L["Companion_Clear"]" aria-label="@L["Companion_Clear"]" data-testid="companion-clear">@Html.Raw(Svg("<path d=\"M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6\"/>", "size-4"))</button>
                <button type="button" id="companion-close" class="@Ui.IconBtn" aria-label="@L["Close"]">@Html.Raw(Svg("<path d=\"M18 6 6 18M6 6l12 12\"/>", "size-4"))</button>
            </header>
            <div id="companion-chat" class="grow overflow-y-auto p-4 space-y-3" aria-live="polite"></div>
            @if (isTeacherCompanion)
            {
                <div class="px-4 pb-2 flex flex-wrap gap-2" id="companion-quick">
                    <button type="button" class="py-1 px-2.5 rounded-full border border-layer-line text-xs text-foreground hover:bg-layer-hover" data-ask="@L["TeacherCompanion_QuickRisk"]">🔎 @L["TeacherCompanion_QuickRisk"]</button>
                    <button type="button" class="py-1 px-2.5 rounded-full border border-layer-line text-xs text-foreground hover:bg-layer-hover" data-ask="@L["TeacherCompanion_QuickProgress"]">📈 @L["TeacherCompanion_QuickProgress"]</button>
                    <button type="button" class="py-1 px-2.5 rounded-full border border-layer-line text-xs text-foreground hover:bg-layer-hover" data-ask="@L["TeacherCompanion_QuickReteach"]">🔁 @L["TeacherCompanion_QuickReteach"]</button>
                </div>
            }
            else
            {
                <div class="px-4 pb-2 flex flex-wrap gap-2" id="companion-quick">
                    <button type="button" class="py-1 px-2.5 rounded-full border border-layer-line text-xs text-foreground hover:bg-layer-hover" data-ask="@L["Companion_QuickNext"]">🧭 @L["Companion_QuickNext"]</button>
                    <button type="button" class="py-1 px-2.5 rounded-full border border-layer-line text-xs text-foreground hover:bg-layer-hover" data-ask="@L["Companion_QuickProgress"]">📈 @L["Companion_QuickProgress"]</button>
                    <button type="button" class="py-1 px-2.5 rounded-full border border-layer-line text-xs text-foreground hover:bg-layer-hover" data-ask="@L["Companion_QuickHelp"]">🆘 @L["Companion_QuickHelp"]</button>
                </div>
            }
            <form id="companion-form" class="p-4 pt-2 border-t border-card-divider">
                <div class="flex items-end gap-2">
                    <label for="companion-text" class="sr-only">@L[isTeacherCompanion ? "TeacherCompanion_Placeholder" : "Companion_Placeholder"]</label>
                    <textarea id="companion-text" rows="2" maxlength="500" class="@Ui.Input resize-none" placeholder="@L[isTeacherCompanion ? "TeacherCompanion_Placeholder" : "Companion_Placeholder"]" data-testid="companion-text"></textarea>
                    <button type="button" id="companion-mic" class="@Ui.IconBtn shrink-0 tip" aria-pressed="false" data-tip="@L["Voice_Dictate"]" aria-label="@L["Voice_Dictate"]" hidden>🎤</button>
                    <button type="submit" class="@Ui.BtnPrimary shrink-0" data-testid="companion-send">@L["Companion_Send"]</button>
                </div>
                <p class="mt-2 text-[11px] text-muted-foreground-1">@L[isTeacherCompanion ? "TeacherCompanion_Privacy" : "Companion_Privacy"]</p>
            </form>
        </aside>
        <script src="~/js/companion.js" asp-append-version="true" defer></script>
    }

    <script type="application/json" id="i18n">@Html.Raw(jsStrings)</script>
    <script src="~/lib/preline/preline.js" asp-append-version="true"></script>
    <script src="~/js/shell.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
