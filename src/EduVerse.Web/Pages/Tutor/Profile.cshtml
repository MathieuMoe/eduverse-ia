@page
@model EduVerse.Web.Pages.Tutor.ProfileModel
@{
    ViewData["Title"] = L["Nav_TutorProfile"];
    var culture = System.Globalization.CultureInfo.CurrentCulture;
    var p = Model.Profile;
    string DayName(DayOfWeek d) => culture.DateTimeFormat.GetDayName(d);
}
<div class="flex flex-wrap justify-between items-end gap-3">
    <div class="min-w-0">
        <h1 class="text-3xl font-semibold tracking-tight text-foreground">@L["Nav_TutorProfile"]</h1>
        <p class="mt-1 text-sm text-muted-foreground-1 max-w-3xl">@L["Profile_Subtitle"]</p>
    </div>
    @if (p.Published) { <a href="/Marketplace/Tutor?id=@p.UserId" class="@Ui.BtnLight">@L["Tutor_SeePublic"]</a> }
</div>

@if (Model.Notice is { } notice)
{
    <div class="p-3 rounded-2xl text-sm @(notice == "Profile_Saved" ? "bg-emerald-50 text-emerald-800 dark:bg-emerald-500/15 dark:text-emerald-300" : "bg-amber-50 text-amber-800 dark:bg-amber-500/15 dark:text-amber-300")" role="status">@L[$"Notice_{notice}"]</div>
}

<form method="post" class="grid xl:grid-cols-12 gap-4 sm:gap-5 items-start">
    <section class="@Ui.Card xl:col-span-7 p-5 space-y-4 min-w-0" aria-labelledby="presentation-title">
        <h2 id="presentation-title" class="text-base font-semibold text-foreground">@L["Profile_Presentation"]</h2>
        <div><label class="@Ui.Label" for="headline">@L["Profile_Headline"]</label><input id="headline" name="headline" value="@p.Headline" class="@Ui.Input" maxlength="140" placeholder="@L["Profile_HeadlinePlaceholder"]" /></div>
        <div><label class="@Ui.Label" for="bio">@L["Profile_Bio"]</label><textarea id="bio" name="bio" rows="5" maxlength="1200" class="@Ui.Input">@p.Bio</textarea></div>
        <div class="grid sm:grid-cols-[1fr_10rem] gap-4">
            <div><label class="@Ui.Label" for="subjects">@L["Market_Subjects"]</label><input id="subjects" name="subjects" value="@string.Join(", ", Model.Subjects)" class="@Ui.Input" placeholder="@L["Profile_SubjectsPlaceholder"]" />
                <p class="mt-1 text-xs text-muted-foreground-1">@L["Profile_SubjectsHint"]</p></div>
            <div><label class="@Ui.Label" for="price">@L["Profile_Price"]</label><input id="price" name="price" type="number" min="5" max="200" step="0.5" value="@p.PricePerHour.ToString(System.Globalization.CultureInfo.InvariantCulture)" class="@Ui.Input" /></div>
        </div>
        <fieldset>
            <legend class="@Ui.Label">@L["Market_Languages"]</legend>
            <div class="flex flex-wrap gap-2">
                @foreach (var l in Enum.GetValues<TeachLanguage>())
                {
                    <label class="inline-flex items-center gap-2 py-1.5 px-3 rounded-full border border-layer-line bg-layer text-sm cursor-pointer has-checked:border-primary has-checked:bg-primary/10">
                        <input type="checkbox" name="languages" value="@l" checked="@Model.Languages.Contains(l)" class="accent-primary" />@L[$"Language_{l}"]
                    </label>
                }
            </div>
        </fieldset>
        <fieldset>
            <legend class="@Ui.Label">@L["Market_Stages"]</legend>
            <div class="flex flex-wrap gap-2">
                @foreach (var s in Enum.GetValues<Stage>())
                {
                    <label class="inline-flex items-center gap-2 py-1.5 px-3 rounded-full border border-layer-line bg-layer text-sm cursor-pointer has-checked:border-primary has-checked:bg-primary/10">
                        <input type="checkbox" name="stages" value="@s" checked="@Model.Stages.Contains(s)" class="accent-primary" />@L[$"Stage_{s}"]
                    </label>
                }
            </div>
        </fieldset>
    </section>

    <section class="@Ui.Card xl:col-span-5 p-5 space-y-4 min-w-0" aria-labelledby="availability-title">
        <h2 id="availability-title" class="text-base font-semibold text-foreground">@L["Profile_Availability"]</h2>
        <p class="text-xs text-muted-foreground-1">@string.Format(culture, L["Profile_AvailabilityHint"], Model.Zone.Id)</p>
        <div class="space-y-2" data-testid="availability">
            @foreach (var d in EduVerse.Web.Pages.Tutor.ProfileModel.WeekOrder)
            {
                var slot = Model.Week.FirstOrDefault(w => w.Day == d);
                <div class="grid grid-cols-[7rem_1fr_1fr] gap-2 items-center">
                    <span class="text-sm text-foreground capitalize">@DayName(d)</span>
                    <label class="sr-only" for="from-@d">@L["Profile_From"]</label>
                    <select id="from-@d" name="from[@d]" class="@Ui.Input py-2"><option value="">–</option>@for (var h = 7; h <= 22; h++) { <option value="@h" selected="@(slot?.StartHour == h)">@($"{h:00}:00")</option> }</select>
                    <label class="sr-only" for="to-@d">@L["Profile_To"]</label>
                    <select id="to-@d" name="to[@d]" class="@Ui.Input py-2"><option value="">–</option>@for (var h = 8; h <= 23; h++) { <option value="@h" selected="@(slot?.EndHour == h)">@($"{h:00}:00")</option> }</select>
                </div>
            }
        </div>
        <label class="flex items-center justify-between gap-3 p-3 rounded-2xl tone-lavender text-sm text-foreground cursor-pointer">
            <span><span class="font-semibold">@L["Profile_Publish"]</span><span class="block text-xs text-foreground/70">@L["Profile_PublishHint"]</span></span>
            <input type="checkbox" name="published" value="true" checked="@p.Published" class="relative shrink-0 w-10 h-6 p-px bg-surface-1 border-transparent rounded-full cursor-pointer appearance-none transition-colors checked:bg-primary before:inline-block before:size-5 before:bg-white before:rounded-full before:shadow before:transition before:translate-x-0 checked:before:translate-x-4" data-testid="publish" />
        </label>
        <button type="submit" class="@Ui.BtnPrimary w-full">@L["Save"]</button>
        <p class="text-xs text-muted-foreground-1">@L["Market_Commission"]</p>
    </section>
</form>
