@page
@model EduVerse.Web.Pages.Tutor.IndexModel
@using EduVerse.Core.Marketplace
@{
    ViewData["Title"] = L["Nav_TutorHome"];
    var culture = System.Globalization.CultureInfo.CurrentCulture;
    var e = Model.Earnings;
    var upcoming = Model.Bookings.Where(b => b.Status is BookingStatus.Confirmed or BookingStatus.Pending).ToList();
    var next = upcoming.FirstOrDefault(b => b.Status == BookingStatus.Confirmed);
    var maxMonth = Math.Max(1m, e.Months.Max(m => m.Net));
}
<div class="flex flex-wrap justify-between items-end gap-3">
    <div class="min-w-0">
        <h1 class="text-3xl font-semibold tracking-tight text-foreground" data-greeting="@User.DisplayName()">@string.Format(culture, L["Teacher_Hello"], User.DisplayName())</h1>
        <p class="mt-1 text-sm text-muted-foreground-1">@L["Tutor_Subtitle"]</p>
    </div>
    <div class="flex gap-2">
        <a href="/Tutor/Profile" class="@Ui.BtnLight">@L["Nav_TutorProfile"]</a>
        @if (Model.Profile.Published) { <a href="/Marketplace/Tutor?id=@Model.Profile.UserId" class="@Ui.BtnLight">@L["Tutor_SeePublic"]</a> }
    </div>
</div>

@if (!Model.Profile.Published)
{
    <div class="p-4 rounded-2xl tone-lavender text-sm text-foreground">@L["Tutor_NotPublished"] <a class="font-semibold underline" href="/Tutor/Profile">@L["Nav_TutorProfile"]</a></div>
}
@if (Model.Notice is { } notice)
{
    <div class="p-3 rounded-2xl text-sm @(notice == "Action_Failed" ? "bg-red-50 text-red-800 dark:bg-red-500/15 dark:text-red-300" : "bg-emerald-50 text-emerald-800 dark:bg-emerald-500/15 dark:text-emerald-300")" role="status">@L[$"Notice_{notice}"]</div>
}

<div class="grid sm:grid-cols-2 xl:grid-cols-4 gap-4 sm:gap-5">
    <div class="@Ui.Kpi tone-mint">
        <p class="@Ui.KpiLabel">@L["Tutor_NetMonth"]</p>
        <p class="@Ui.KpiValue">@Ui.Money(e.Net)</p>
        <div class="mt-4 flex items-end gap-1.5 h-16" role="img" aria-label="@L["Tutor_Months"]">
            @foreach (var (month, net) in e.Months)
            {
                <div class="flex-1 min-w-0 flex flex-col items-center gap-1 h-full justify-end tip" data-tip="@month.ToString("MMMM yyyy", culture): @Ui.Money(net)">
                    <div class="w-full max-w-7 rounded-lg bar-solid" style="height:@(Math.Max(6, (int)(100 * net / maxMonth)))%"></div>
                    <span class="text-[10px] leading-none text-foreground/60 uppercase">@month.ToString("MMM", culture)[..1]</span>
                </div>
            }
        </div>
    </div>
    <div class="@Ui.Kpi tone-lavender">
        <p class="@Ui.KpiLabel">@L["Tutor_Commission"]</p>
        <p class="@Ui.KpiValue">@((e.CurrentRate * 100).ToString("0", culture)) %</p>
        <p class="mt-auto pt-4 text-xs text-foreground/70">@string.Format(culture, L["Tutor_CommissionLine"], Ui.Money(e.Gross), Ui.Money(e.Commission), e.Lessons)</p>
    </div>
    <div class="@Ui.Kpi tone-pink">
        <p class="@Ui.KpiLabel">@L["Tutor_Rating"]</p>
        <p class="@Ui.KpiValue">@(Model.Card?.Rating is { } avg ? avg.ToString("0.0", culture) : "–")</p>
        <p class="mt-auto pt-4 text-xs text-foreground/70">@string.Format(culture, L["Market_Reviews"], Model.Card?.Reviews ?? 0) · @string.Format(culture, L["Market_Lessons"], Model.Card?.Lessons ?? 0)</p>
    </div>
    <div class="@Ui.Kpi tone-plum">
        <p class="text-sm font-semibold text-white/80">@L["Tutor_Next"]</p>
        @if (next is not null)
        {
            <p class="mt-2 text-xl font-semibold leading-snug">@Ui.When(next.Booking.Start, Model.Zone)</p>
            <p class="mt-1 text-sm text-white/70">@next.StudentName · @next.Booking.Subject</p>
        }
        else
        {
            <p class="mt-2 text-sm text-white/70">@L["Tutor_NoNext"]</p>
        }
    </div>
</div>

<div class="grid xl:grid-cols-12 gap-4 sm:gap-5 items-start">
    <section class="@Ui.Card xl:col-span-8 min-w-0" aria-labelledby="tutor-bookings">
        <div class="@Ui.CardHeader"><h2 id="tutor-bookings" class="text-base font-semibold text-foreground">@L["Tutor_Upcoming"]</h2></div>
        @if (upcoming.Count == 0)
        {
            <p class="p-6 text-sm text-muted-foreground-1">@L["Tutor_NoBookings"]</p>
        }
        <ul class="divide-y divide-card-divider" data-testid="tutor-upcoming">
            @foreach (var b in upcoming)
            {
                <li class="p-5 flex flex-col md:flex-row md:items-center gap-4">
                    <div class="flex items-center gap-3 grow min-w-0">
                        <span class="size-11 shrink-0 grid place-items-center rounded-full text-sm font-bold text-foreground @Ui.AvatarTone(b.StudentName)">@Ui.Initials(b.StudentName)</span>
                        <div class="min-w-0">
                            <p class="font-semibold text-foreground truncate">@b.StudentName <span class="font-normal text-muted-foreground-1">· @b.Booking.Subject</span></p>
                            <p class="text-sm text-foreground">@Ui.When(b.Booking.Start, Model.Zone)</p>
                            @if (b.Booking.Note is { } note) { <p class="mt-1 text-xs text-muted-foreground-1">“@note”</p> }
                        </div>
                    </div>
                    <div class="text-sm text-end shrink-0">
                        <p class="font-semibold text-foreground">@Ui.Money(b.Booking.Price - b.Booking.Commission)</p>
                        <p class="text-xs text-muted-foreground-1">@(b.Status == BookingStatus.Pending ? L["BookingStatus_Pending"] : string.Format(culture, L["Tutor_AfterCommission"], Ui.Money(b.Booking.Commission)))</p>
                    </div>
                    <partial name="/Pages/Marketplace/_BookingStatus.cshtml" model="b.Status" />
                    @if (b.CanCancel)
                    {
                        <form method="post" asp-page-handler="Cancel" asp-route-id="@b.Booking.Id">
                            <button type="submit" class="@Ui.BtnLight tip" data-tip="@L["Tutor_CancelHint"]">@L["Bookings_Cancel"]</button>
                        </form>
                    }
                </li>
            }
        </ul>
    </section>
    <section class="@Ui.Card xl:col-span-4 p-5 min-w-0" aria-labelledby="tutor-reviews">
        <h2 id="tutor-reviews" class="text-base font-semibold text-foreground">@L["Market_ReviewsTitle"]</h2>
        @if (Model.Reviews.Count == 0) { <p class="mt-2 text-sm text-muted-foreground-1">@L["Market_NoReviews"]</p> }
        <ul class="mt-3 divide-y divide-card-divider">
            @foreach (var r in Model.Reviews)
            {
                <li class="py-3">
                    <p class="text-sm"><span class="text-amber-600 dark:text-amber-400">@(new string('★', r.Rating))@(new string('☆', 5 - r.Rating))</span> <span class="font-semibold text-foreground">@r.Student</span></p>
                    @if (r.Review is { } text) { <p class="mt-1 text-sm text-muted-foreground-1">@text</p> }
                </li>
            }
        </ul>
    </section>
</div>
