@page
@model EduVerse.Web.Pages.Student.AchievementsModel
@using EduVerse.Core.Gamification
@{
    ViewData["Title"] = L["Nav_Achievements"];
    var culture = System.Globalization.CultureInfo.CurrentCulture;
    var g = Model.Game;
    var ranks = new[] { (1, "Explorer", "🧭"), (3, "Apprentice", "📘"), (5, "Scholar", "🎓"), (8, "Expert", "🔭"), (11, "Master", "🏛️"), (15, "Sage", "🦉") };
}
@if (Model.Kids)
{
    <!-- Kid achievements: a sticker shelf — no XP thresholds, no rank ladder, no percentages. -->
    <div class="flex flex-col items-center text-center gap-3" data-testid="kid-ach-header">
        <partial name="_Mascot" model="@("size-20 shrink-0")" />
        <h1 class="text-2xl font-semibold tracking-tight text-foreground">@L["Nav_Achievements"]</h1>
        <p class="text-base text-muted-foreground-1">@L["KidAch_Subtitle"]</p>
        <p class="text-sm font-semibold text-foreground">@string.Format(culture, L["KidAch_Earned"], g.Badges.Count(b => b.EarnedAt.HasValue), g.Badges.Count)</p>
    </div>

    <ul class="grid grid-cols-3 sm:grid-cols-4 gap-4" data-testid="kid-badges">
        @foreach (var b in g.Badges)
        {
            <li class="p-4 rounded-3xl flex flex-col items-center gap-1 text-center @(b.EarnedAt.HasValue ? "tone-sun" : "bg-surface")" data-testid="kid-badge" data-earned="@(b.EarnedAt.HasValue ? "1" : "0")">
                <span class="text-5xl @(b.EarnedAt.HasValue ? "" : "grayscale opacity-40")" aria-hidden="true">@b.Badge.Icon</span>
                <span class="text-sm font-semibold text-foreground">@L[$"Badge_{b.Badge.Key}"]</span>
            </li>
        }
    </ul>

    @if (g.Quests.Count > 0)
    {
        <section class="@Ui.Card p-5" data-testid="kid-quests">
            <h2 class="text-lg font-semibold text-foreground text-center">@L["Game_Quests"]</h2>
            <ul class="mt-3 flex flex-wrap justify-center gap-3">
                @foreach (var q in g.Quests)
                {
                    <li class="py-2 px-4 rounded-full text-sm font-medium @(q.Done ? "tone-mint" : "bg-surface text-muted-foreground-1")">@(q.Done ? "✅ " : "⭘ ")@string.Format(culture, L[$"QuestText_{q.Quest.Kind}"], q.Quest.Target)</li>
                }
            </ul>
        </section>
    }
}
else
{
    <div class="flex flex-wrap justify-between items-end gap-3">
        <div class="min-w-0">
            <h1 class="text-3xl font-semibold tracking-tight text-foreground">@L["Nav_Achievements"]</h1>
            <p class="mt-1 text-sm text-muted-foreground-1 max-w-3xl">@L["Achievements_Subtitle"]</p>
        </div>
        <span class="@Ui.Pill tone-lavender text-foreground py-1.5 px-3 text-sm">@string.Format(culture, L["Game_LevelN"], g.Level) · @g.Xp.ToString("N0", culture) XP</span>
    </div>

    <section class="@Ui.Card p-5">
        <h2 class="text-base font-semibold text-foreground">@L["Achievements_Path"]</h2>
        <ol class="mt-4 grid grid-cols-3 md:grid-cols-6 gap-3">
            @foreach (var (from, rank, icon) in ranks)
            {
                var reached = g.Level >= from;
                var current = Xp.Rank(g.Level) == rank;
                <li class="p-3 rounded-2xl text-center @(current ? "tone-plum" : reached ? "tone-lavender" : "bg-surface opacity-60")">
                    <span class="text-3xl" aria-hidden="true">@icon</span>
                    <span class="mt-1 block text-sm font-semibold @(current ? "text-white" : "text-foreground")">@L[$"Rank_{rank}"]</span>
                    <span class="block text-[11px] @(current ? "text-white/70" : "text-muted-foreground-1")">@string.Format(culture, L["Achievements_FromLevel"], from) · @Xp.NeededFor(from) XP</span>
                </li>
            }
        </ol>
    </section>

    <div class="grid xl:grid-cols-12 gap-4 sm:gap-6 items-start">
        <section class="xl:col-span-8 @Ui.Card p-5 min-w-0" data-testid="badges">
            <h2 class="text-base font-semibold text-foreground">@L["Game_Badges"] <span class="text-sm font-normal text-muted-foreground-1">@g.Badges.Count(b => b.EarnedAt.HasValue) / @g.Badges.Count</span></h2>
            <ul class="mt-4 grid sm:grid-cols-2 lg:grid-cols-3 gap-3">
                @foreach (var b in g.Badges)
                {
                    var pct = 100 * b.Progress / b.Badge.Goal;
                    <li class="p-4 rounded-2xl flex gap-3 @(b.EarnedAt.HasValue ? "tone-sun" : "bg-surface")">
                        <span class="size-12 shrink-0 rounded-2xl grid place-items-center text-2xl @(b.EarnedAt.HasValue ? "bg-white/70 dark:bg-white/10" : "grayscale opacity-50")" aria-hidden="true">@b.Badge.Icon</span>
                        <div class="min-w-0 grow">
                            <p class="text-sm font-semibold text-foreground">@L[$"Badge_{b.Badge.Key}"]</p>
                            <p class="text-xs text-muted-foreground-1">@string.Format(culture, L[$"BadgeHint_{b.Badge.Key}"], b.Badge.Goal)</p>
                            @if (b.EarnedAt is { } at)
                            {
                                <p class="mt-1 text-[11px] text-foreground/70">✓ @at.ToString("d MMM yyyy", culture)</p>
                            }
                            else
                            {
                                <div class="mt-2 h-1.5 rounded-full bg-white/70 dark:bg-white/10 overflow-hidden"><div class="h-full rounded-full bg-primary" style="width:@(pct)%"></div></div>
                                <p class="mt-1 text-[11px] text-muted-foreground-1">@b.Progress / @b.Badge.Goal</p>
                            }
                        </div>
                    </li>
                }
            </ul>
        </section>
        <aside class="xl:col-span-4 space-y-4 sm:space-y-6 min-w-0">
            <section class="@Ui.Card p-5">
                <h2 class="text-base font-semibold text-foreground">@L["Game_Quests"]</h2>
                <ul class="mt-3 space-y-2">
                    @foreach (var q in g.Quests)
                    {
                        <li class="flex items-center justify-between gap-2 p-3 rounded-2xl @(q.Done ? "tone-mint" : "bg-surface") text-sm">
                            <span class="text-foreground">@(q.Done ? "✅ " : "")@string.Format(culture, L[$"QuestText_{q.Quest.Kind}"], q.Quest.Target)</span>
                            <span class="text-xs text-muted-foreground-1 shrink-0">@q.Progress/@q.Quest.Target</span>
                        </li>
                    }
                </ul>
            </section>
            <section class="@Ui.Card p-5" data-testid="calibration">
                <h2 class="text-base font-semibold text-foreground">😎 @L["Calibration_Title"]</h2>
                @if (EduVerse.Core.Catalog.Spaced.Calibration(g.Sure, g.SureRight) is { } cal)
                {
                    <p class="mt-2 text-3xl font-semibold text-foreground">@cal %</p>
                    <p class="text-sm text-muted-foreground-1">@string.Format(culture, L["Calibration_Sure"], g.SureRight, g.Sure)</p>
                    @if (g.Unsure > 0)
                    {
                        <p class="mt-1 text-sm text-muted-foreground-1">@string.Format(culture, L["Calibration_Unsure"], g.UnsureRight, g.Unsure)</p>
                    }
                    <p class="mt-3 p-3 rounded-2xl @(cal >= 85 ? "tone-mint" : cal >= 60 ? "tone-sky" : "tone-peach") text-sm text-foreground">@L[cal >= 85 ? "Calibration_Good" : cal >= 60 ? "Calibration_Ok" : "Calibration_Low"]</p>
                }
                else
                {
                    <p class="mt-2 text-sm text-muted-foreground-1">@L["Calibration_Empty"]</p>
                }
            </section>
            <section class="@Ui.Card p-5">
                <h2 class="text-base font-semibold text-foreground">@L["Achievements_HowXp"]</h2>
                <ul class="mt-3 space-y-1.5 text-sm text-foreground">
                    <li class="flex justify-between"><span>@L["Achievements_XpRight"]</span><span class="font-semibold">10–25</span></li>
                    <li class="flex justify-between"><span>@L["Achievements_XpHint"]</span><span class="font-semibold">−25 %</span></li>
                    <li class="flex justify-between"><span>@L["Achievements_XpSure"]</span><span class="font-semibold">+@Xp.SureBonus</span></li>
                    <li class="flex justify-between"><span>@L["Achievements_XpTry"]</span><span class="font-semibold">@Xp.Wrong</span></li>
                    <li class="flex justify-between"><span>@L["Achievements_XpTest"]</span><span class="font-semibold">@Xp.TestFinished (+@Xp.PerfectTest)</span></li>
                    <li class="flex justify-between"><span>@L["Achievements_XpDuel"]</span><span class="font-semibold">@Xp.DuelWin</span></li>
                    <li class="flex justify-between"><span>@L["Achievements_XpBadge"]</span><span class="font-semibold">@Xp.Badge</span></li>
                </ul>
                <p class="mt-3 text-xs text-muted-foreground-1">@L["Achievements_Fair"]</p>
            </section>
        </aside>
    </div>
}
