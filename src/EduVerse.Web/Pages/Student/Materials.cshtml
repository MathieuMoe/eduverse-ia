@page
@model EduVerse.Web.Pages.Student.MaterialsModel
@using EduVerse.Core.Tutor
@{
    ViewData["Title"] = L["Nav_Materials"];
}
<div class="min-w-0">
    <h1 class="text-3xl font-semibold tracking-tight text-foreground">📄 @L["Nav_Materials"]</h1>
    <p class="mt-1 text-sm text-muted-foreground-1 max-w-3xl">@L["Materials_Subtitle"]</p>
</div>

@if (Model.Items.Count == 0)
{
    <p class="@Ui.Card p-5 text-sm text-muted-foreground-1" data-testid="materials-empty">@L["Materials_Empty"]</p>
}
else
{
    <div class="grid xl:grid-cols-2 gap-4 items-start">
        @foreach (var item in Model.Items)
        {
            var m = item.Material;
            <section id="material-@m.Id" class="@Ui.Card p-5" data-testid="student-material">
                <h2 class="text-base font-semibold text-foreground">@m.Title</h2>
                <p class="text-xs text-muted-foreground-1">@item.ClassName · @L["MatTarget_" + m.Target]@(m.Target == MaterialTarget.Figure ? " (" + Interviews.Find(m.Key)?.Name + ")" : "")</p>
                <details class="mt-3">
                    <summary class="text-sm font-medium text-primary cursor-pointer">@L["Materials_Read"]</summary>
                    <p class="mt-2 text-sm text-foreground whitespace-pre-line max-h-96 overflow-y-auto">@m.Text</p>
                </details>
                <div class="mt-4 flex flex-wrap gap-2">
                    <a class="@Ui.BtnPrimary" href="/Student/Quiz?material=@m.Id" data-testid="material-quiz">📝 @L["Materials_Test"]</a>
                    @if (m.Target == MaterialTarget.Figure)
                    {
                        <a class="@Ui.BtnLight" href="/Student/Interview?figure=@m.Key">🎙️ @string.Format(System.Globalization.CultureInfo.CurrentCulture, L["Materials_Ask"].Value, Interviews.Find(m.Key)?.Name)</a>
                    }
                </div>
            </section>
        }
    </div>
}
<p class="text-xs text-muted-foreground-1 max-w-3xl">ℹ️ @L["Materials_Footer"]</p>
@if (Model.Items.Count > 0)
{
    <script>
        // Arriving from the detective's "your teacher's own document" link: open and show that one document.
        (() => {
            const target = document.getElementById(location.hash.slice(1));
            if (!target) { return; }
            const details = target.querySelector("details");
            if (details) { details.open = true; }
            target.scrollIntoView({ block: "center" });
        })();
    </script>
}
