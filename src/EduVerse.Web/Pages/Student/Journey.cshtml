@page
@model EduVerse.Web.Pages.Student.JourneyModel
@using EduVerse.Core.Tutor
@{
    ViewData["Title"] = L["Nav_Journey"];
    var culture = System.Globalization.CultureInfo.CurrentCulture;
}
<div class="min-w-0">
    <h1 class="text-3xl font-semibold tracking-tight text-foreground">🧭 @L["Nav_Journey"]</h1>
    <p class="mt-1 text-sm text-muted-foreground-1 max-w-3xl">@L["Journey_Subtitle"]</p>
</div>

@if (Model.Milestones.Count == 0)
{
    <section class="@Ui.Card p-5" data-testid="journey-empty"><p class="text-sm text-muted-foreground-1">@L["Journey_Empty"]</p></section>
}
else
{
    <ol class="mt-2 space-y-4 max-w-2xl" data-testid="journey">
        @foreach (var m in Model.Milestones)
        {
            <li class="@Ui.Card p-4 flex gap-3" data-testid="journey-milestone" data-kind="@m.Kind">
                <span class="text-2xl leading-none" aria-hidden="true">@m.Icon</span>
                <div class="min-w-0">
                    <p class="text-xs text-muted-foreground-1">@(m.Kind == MilestoneKind.TopicTurnaround ? m.Date.ToString("MMMM yyyy", culture) : m.Date.ToString("d MMMM yyyy", culture))</p>
                    <p class="mt-0.5 text-sm text-foreground">@m.Text</p>
                </div>
            </li>
        }
    </ol>
}
