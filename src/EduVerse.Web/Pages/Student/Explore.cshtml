@page
@model EduVerse.Web.Pages.Student.ExploreModel
@using EduVerse.Core.Catalog
@{
    ViewData["Title"] = L["Nav_Explore"];
    var culture = System.Globalization.CultureInfo.CurrentCulture;
}
<div class="flex flex-wrap justify-between items-end gap-3">
    <div class="min-w-0">
        <h1 class="text-3xl font-semibold tracking-tight text-foreground">@L["Explore_Title"]</h1>
        <p class="mt-1 text-sm text-muted-foreground-1 max-w-3xl">@L["Explore_Subtitle"]</p>
    </div>
</div>

<nav class="@Ui.Card p-3" aria-label="@L["Field_Level"]">
    <ol class="flex gap-2 overflow-x-auto pb-1" data-testid="levels">
        @foreach (var lv in Enum.GetValues<Level>())
        {
            var active = lv == Model.Level;
            <li class="shrink-0">
                <a href="/Student/Explore?level=@lv" class="flex flex-col items-start py-2 px-3.5 rounded-2xl border text-left @(active ? "tone-plum border-transparent" : "border-layer-line bg-layer hover:bg-layer-hover")" aria-current="@(active ? "page" : null)">
                    <span class="text-sm font-semibold @(active ? "text-white" : "text-foreground") whitespace-nowrap">@L[$"LevelShort_{lv}"]@(lv == Model.ProfileLevel ? " ★" : "")</span>
                    <span class="text-[11px] @(active ? "text-white/70" : "text-muted-foreground-1") whitespace-nowrap">@string.Format(culture, L["Explore_Ages"], Levels.Ages(lv))</span>
                </a>
            </li>
        }
    </ol>
</nav>

@if (Model.Notice is { } notice)
{
    <div class="p-3 rounded-lg text-sm bg-teal-50 text-teal-800 dark:bg-teal-500/15 dark:text-teal-300" role="status">@L[$"Notice_{notice}"]</div>
}
@if (Model.Level != Model.ProfileLevel)
{
    <form method="post" asp-page-handler="Apply" class="p-4 rounded-3xl tone-lavender flex flex-wrap items-center justify-between gap-3" data-testid="apply-level">
        <input type="hidden" name="level" value="@Model.Level" />
        <p class="text-sm text-foreground">@string.Format(culture, L["Explore_Viewing"], L[$"Level_{Model.Level}"], L[$"Level_{Model.ProfileLevel}"])</p>
        <button type="submit" class="@Ui.BtnPrimary">@string.Format(culture, L["Explore_ApplyAll"], L[$"LevelShort_{Model.Level}"])</button>
    </form>
}

@if (Model.Kids)
{
    <div class="p-4 rounded-3xl tone-sun flex items-center gap-4">
        <partial name="_Mascot" model="@("size-16 shrink-0")" />
        <p class="text-lg font-semibold text-foreground">@L["Explore_KidsHello"]</p>
    </div>
}

<div class="grid sm:grid-cols-2 xl:grid-cols-3 gap-4 sm:gap-5" data-testid="subjects">
    @foreach (var p in Model.Progress)
    {
        var info = Catalog.Info(p.Area);
        var available = Catalog.Available(p.Area, Model.Level);
        <section class="@Ui.Card p-5 min-w-0 @(available ? "" : "opacity-60")" data-area="@p.Area">
            <div class="flex items-start gap-3">
                <span class="@(Model.Kids ? "size-16 text-4xl" : "size-12 text-2xl") shrink-0 rounded-2xl tone-@info.Tone grid place-items-center" aria-hidden="true">@info.Icon</span>
                <div class="min-w-0 grow">
                    <h2 class="@(Model.Kids ? "text-xl" : "text-base") font-semibold text-foreground">@L[$"Area_{p.Area}"]</h2>
                    <p class="text-xs text-muted-foreground-1">@L[$"AreaHint_{p.Area}"]</p>
                </div>
            </div>
            <dl class="mt-4 grid grid-cols-2 gap-2 text-sm">
                <div class="p-2.5 rounded-xl bg-surface"><dt class="text-[11px] text-muted-foreground-1">@L["Explore_TestLevel"]</dt><dd class="font-semibold text-foreground truncate" data-testid="test-level">@L[$"LevelShort_{Model.TestLevel(p.Area)}"]</dd></div>
                <div class="p-2.5 rounded-xl bg-surface"><dt class="text-[11px] text-muted-foreground-1">@L["Explore_Accuracy"]</dt><dd class="font-semibold text-foreground">@(p.Answers == 0 ? "–" : $"{p.Accuracy} %")</dd></div>
            </dl>
            <p class="mt-2 text-[11px] text-muted-foreground-1">@string.Format(culture, L["Explore_TestsDone"], p.Tests)@(p.Placed && p.Level != Model.TestLevel(p.Area) ? " · " + string.Format(culture, L["Explore_PlacedAt"], L[$"LevelShort_{p.Level}"]) : "")</p>
            @if (p.Weak.Count > 0)
            {
                <p class="mt-3 text-xs text-muted-foreground-1">@L["Explore_Review"]</p>
                <ul class="mt-1 flex flex-wrap gap-1.5">
                    @foreach (var w in p.Weak)
                    {
                        <li class="@Ui.Pill heat-1">@EduVerse.Web.QuizEndpoints.TopicName(w.Topic, L)</li>
                    }
                </ul>
            }
            <div class="mt-4 flex flex-wrap gap-2">
                @if (available)
                {
                    <a href="/Student/Quiz?area=@p.Area&level=@Model.TestLevel(p.Area)" class="@Ui.BtnPrimary @(Model.Kids ? "text-base py-3 px-6" : "")" data-testid="start-@p.Area">@(Model.Kids ? "▶ " + L["Explore_Play"] : L["Explore_Start"])</a>
                }
                else
                {
                    <span class="text-xs text-muted-foreground-1">@string.Format(culture, L["Explore_From"], L[$"LevelShort_{info.MinLevel}"])</span>
                }
                @if (available)
                {
                    <a href="/Student/Quiz?area=@p.Area&level=@Model.TestLevel(p.Area)&mode=Evo" class="@Ui.BtnLight tip" data-testid="evo-@p.Area" data-tip="@L["Evo_Hint"]">🦉 @L["QuizMode_Evo"]</a>
                }
                @if (!Model.Kids)
                {
                    <a href="/Student/Quiz?area=@p.Area&mode=Placement" class="@Ui.BtnLight" data-testid="place-@p.Area">@L["Explore_FindLevel"]</a>
                }
            </div>
        </section>
    }
</div>

@if (!Model.Kids)
{
    <section class="@Ui.Card p-5" data-testid="topic-form">
        <div class="flex items-start gap-3">
            <span class="size-10 shrink-0 rounded-xl tone-lavender grid place-items-center">@Html.Raw(Ui.Sparkle)</span>
            <div>
                <h2 class="text-base font-semibold text-foreground">@L["Explore_TopicTitle"]</h2>
                <p class="text-xs text-muted-foreground-1">@L["Explore_TopicHint"]</p>
            </div>
        </div>
        <form method="get" action="/Student/Quiz" class="mt-4 grid sm:grid-cols-12 gap-3 items-end">
            <div class="sm:col-span-3"><label class="@Ui.Label" for="topic-area">@L["Explore_Subject"]</label>
                <select id="topic-area" name="area" class="@Ui.Input">@foreach (var a in Catalog.Areas.Where(a => Catalog.Available(a.Area, Model.Level))) { <option value="@a.Area">@L[$"Area_{a.Area}"]</option> }</select></div>
            <input type="hidden" name="level" value="@Model.Level" />
            <div class="sm:col-span-7"><label class="@Ui.Label" for="topic">@L["Explore_Topic"]</label>
                <input id="topic" name="topic" class="@Ui.Input" maxlength="@TopicQuizPrompt.MaxTopicLength" minlength="2" required placeholder="@L["Explore_TopicPlaceholder"]" /></div>
            <button type="submit" class="@Ui.BtnPrimary sm:col-span-2">@L["Explore_Generate"]</button>
        </form>
    </section>
}
