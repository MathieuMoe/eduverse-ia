@page
@model EduVerse.Web.Pages.Student.LetterModel
@{
    ViewData["Title"] = L["Nav_Letter"];
}
<div class="flex flex-wrap justify-between items-end gap-3 print:hidden">
    <div class="min-w-0">
        <h1 class="text-3xl font-semibold tracking-tight text-foreground">💌 @L["Nav_Letter"]</h1>
        <p class="mt-1 text-sm text-muted-foreground-1 max-w-3xl">@L["Letter_Subtitle"]</p>
    </div>
    @if (Model.Letter is not null)
    {
        <button type="button" class="@Ui.BtnPrimary" onclick="window.print()" data-testid="letter-print">🖨️ @L["Letter_Print"]</button>
    }
</div>

@if (Model.Letter is not { } letter)
{
    <section class="@Ui.Card p-5" data-testid="letter-empty"><p class="text-sm text-muted-foreground-1">@L["Letter_Empty"]</p></section>
}
else
{
    <article class="@Ui.Card p-6 sm:p-8 max-w-2xl tone-sun print:shadow-none print:border-0" data-testid="letter">
        <h2 class="text-xl font-semibold text-foreground">@letter.Title</h2>
        <p class="mt-4 text-sm text-foreground">@letter.Greeting</p>
        <ul class="mt-3 space-y-3">
            @foreach (var part in letter.Parts)
            {
                <li class="flex gap-3 text-sm text-foreground" data-testid="letter-part"><span aria-hidden="true">@part.Icon</span><span>@part.Text</span></li>
            }
        </ul>
        <p class="mt-5 text-xs text-foreground/70">🦉 @letter.Closing</p>
    </article>
}
