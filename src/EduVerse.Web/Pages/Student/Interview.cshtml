@page
@model EduVerse.Web.Pages.Student.InterviewModel
@using EduVerse.Core.Tutor
@{
    ViewData["Title"] = L["Nav_Interview"];
    var language = EduVerse.Web.Localization.LanguageForCurrentCulture();
}
@if (Model.Figure is { } f)
{
    var voice = Interviews.Voice(f);
    <div id="iv-root" class="max-w-5xl w-full mx-auto space-y-4" data-figure="@f.Key" data-level="@Model.Level" data-name="@f.Name"
         data-female="@(voice.Female ? "true" : "false")" data-pitch="@voice.Pitch.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-rate="@voice.Rate.ToString(System.Globalization.CultureInfo.InvariantCulture)">
        <a href="/Student/Interview" class="text-sm text-muted-foreground-1 hover:text-foreground">← @L["Nav_Interview"]</a>
        <div class="grid lg:grid-cols-[18rem_1fr] gap-4 items-start">
            <aside class="@Ui.Card p-5 lg:sticky lg:top-20 flex lg:flex-col items-center gap-4 text-center">
                <div id="iv-avatar" class="relative w-28 sm:w-36 lg:w-56 shrink-0" data-avatar="@f.Key" data-mouth="closed" data-testid="iv-avatar">
                </div>
                <div class="min-w-0 flex-1 lg:flex-none text-start lg:text-center">
                    <h1 class="text-xl font-semibold text-foreground">@f.Name</h1>
                    <p class="text-sm text-muted-foreground-1">@f.Years · @f.Field.In(language)</p>
                    <div class="mt-3 flex flex-wrap lg:justify-center gap-2">
                        <button type="button" id="iv-speak" class="@Ui.BtnLight" aria-pressed="true" data-testid="iv-voice">🔊 <span id="iv-speak-label">@L["Interview_VoiceOn"]</span></button>
                    </div>
                    <p class="mt-3 text-xs text-muted-foreground-1" id="iv-progress" aria-live="polite"></p>
                </div>
            </aside>
            <div class="space-y-4 min-w-0">
                <p class="p-3 rounded-2xl tone-sun text-sm text-foreground" data-testid="simulation-notice">🎭 @L["Interview_Simulation"]</p>
                <section class="@Ui.Card p-5 sm:p-6 space-y-4 relative" aria-live="polite">
                    <div id="iv-start" class="absolute inset-0 z-10 rounded-[inherit] bg-layer/85 backdrop-blur-sm grid place-items-center p-6 text-center">
                        <div>
                            <p class="text-foreground font-medium">@string.Format(System.Globalization.CultureInfo.CurrentCulture, L["Interview_StartHint"], f.Name)</p>
                            <button type="button" id="iv-start-btn" class="@Ui.BtnPrimary mt-4" data-testid="iv-start">▶ @L["Interview_Start"]</button>
                        </div>
                    </div>
                    <div id="iv-chat" class="space-y-3 min-h-40">
                    </div>
                    <template id="iv-greeting">@f.Greeting.In(language)</template>
                    <div class="flex flex-wrap gap-2" id="iv-suggestions" aria-label="@L["Interview_Suggestions"]">
                        @foreach (var a in f.Answers)
                        {
                            <button type="button" class="py-1.5 px-3 rounded-full border border-layer-line text-sm text-foreground hover:bg-layer-hover disabled:opacity-40" data-question="@a.Question.In(language)">💬 @a.Question.In(language)</button>
                        }
                    </div>
                    <form id="iv-form" class="flex gap-2">
                        <label for="iv-text" class="sr-only">@L["Interview_YourQuestion"]</label>
                        <input id="iv-text" class="@Ui.Input" maxlength="@Interviews.MaxQuestion" placeholder="@L["Interview_YourQuestion"]" autocomplete="off" />
                        <button type="button" id="iv-mic" class="@Ui.BtnLight shrink-0" aria-pressed="false" title="@L["Voice_Dictate"]" aria-label="@L["Voice_Dictate"]">🎤</button>
                        <button type="submit" class="@Ui.BtnPrimary shrink-0" data-testid="iv-send">@L["Interview_Ask"]</button>
                    </form>
                    <div id="iv-check" class="hidden p-4 rounded-2xl tone-lavender flex flex-wrap items-center justify-between gap-3">
                        <p class="text-sm text-foreground">@L["Interview_CheckHint"]</p>
                        <a href="/Student/Quiz?mode=Interview&figure=@f.Key&level=@Model.Level" class="@Ui.BtnPrimary" data-testid="iv-check">@L["Interview_Check"]</a>
                    </div>
                </section>
            </div>
        </div>
    </div>
}
else
{
    <div class="flex flex-wrap justify-between items-end gap-3">
        <div class="min-w-0">
            <h1 class="text-3xl font-semibold tracking-tight text-foreground">@L["Interview_Title"]</h1>
            <p class="mt-1 text-sm text-muted-foreground-1 max-w-3xl">@L["Interview_Subtitle"]</p>
        </div>
    </div>
    <div class="grid sm:grid-cols-2 xl:grid-cols-4 gap-4" data-testid="figures">
        @foreach (var fig in Interviews.All)
        {
            <a href="/Student/Interview?figure=@fig.Key" class="@Ui.Card p-5 hover:-translate-y-0.5 transition-transform" data-testid="figure-@fig.Key">
                <span class="block w-24" data-avatar="@fig.Key" data-mouth="closed"></span>
                <span class="mt-3 block text-lg font-semibold text-foreground">@fig.Name</span>
                <span class="block text-xs text-muted-foreground-1">@fig.Years · @fig.Field.In(language)</span>
            </a>
        }
    </div>
    <p class="text-xs text-muted-foreground-1">🎭 @L["Interview_Simulation"]</p>
}

@section Scripts {
    @if (Model.Figure is not null)
    {
        <script src="~/js/common.js" asp-append-version="true"></script>
        <script src="~/js/avatars.js" asp-append-version="true"></script>
        <script src="~/js/voice.js" asp-append-version="true"></script>
        <script src="~/js/interview.js" asp-append-version="true"></script>
    }
    else
    {
        <script src="~/js/avatars.js" asp-append-version="true"></script>
    }
}
