@model EduVerse.Core.Tutor.Figure
@using EduVerse.Core.Tutor
@{
    var language = EduVerse.Web.Localization.LanguageForCurrentCulture();
    var d = Dossiers.For(Model.Key)!;
}
<div class="space-y-4" data-testid="dossier">
    <section class="@Ui.Card p-5 sm:p-6">
        <div class="flex items-center justify-between gap-3">
            <h2 class="text-lg font-semibold text-foreground">💡 @L["Dossier_Discovery"]</h2>
            <button type="button" class="@Ui.BtnLight" data-read-dossier aria-pressed="false">🔊 <span>@L["Dossier_Read"]</span></button>
        </div>
        <div class="mt-4 grid md:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] gap-5 items-center">
            <figure class="rounded-2xl overflow-hidden border border-layer-line bg-layer">
                <div data-discovery="@Model.Key" data-label="@d.Discovery.In(language)"></div>
                <figcaption class="px-3 py-2 text-[11px] text-muted-foreground-1 border-t border-card-divider">@L["Dossier_Illustration"]</figcaption>
            </figure>
            <p class="text-foreground leading-relaxed" data-dossier-text>@d.Discovery.In(language)</p>
        </div>
    </section>
    <div class="grid lg:grid-cols-2 gap-4">
        <section class="@Ui.Card p-5 sm:p-6">
            <h2 class="text-lg font-semibold text-foreground">🗓️ @L["Dossier_Timeline"]</h2>
            <ol class="mt-4 relative border-s-2 border-layer-line ms-3 space-y-4">
                @foreach (var e in d.Timeline)
                {
                    <li class="ms-5">
                        <span class="absolute -start-[7px] mt-1.5 size-3 rounded-full bg-primary" aria-hidden="true"></span>
                        <p class="text-sm font-semibold text-foreground tabular-nums">@e.Year</p>
                        <p class="text-sm text-muted-foreground-1">@e.Text.In(language)</p>
                    </li>
                }
            </ol>
        </section>
        <div class="space-y-4">
            <section class="@Ui.Card p-5 sm:p-6">
                <h2 class="text-lg font-semibold text-foreground">📜 @L["Dossier_Evidence"]</h2>
                <p class="mt-2 text-sm text-foreground leading-relaxed">@d.Evidence.In(language)</p>
                <ul class="mt-4 space-y-2">
                    @foreach (var s in d.Sources)
                    {
                        <li>
                            <a href="@s.Url" target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 p-3 rounded-2xl border border-layer-line hover:bg-layer-hover" data-testid="dossier-source">
                                <span class="size-10 shrink-0 rounded-xl tone-sky grid place-items-center" aria-hidden="true">🏛️</span>
                                <span class="min-w-0 grow">
                                    <span class="block text-sm font-medium text-foreground">@s.Title.In(language)</span>
                                    <span class="block text-xs text-muted-foreground-1">@s.Site · @L["Dossier_External"]</span>
                                </span>
                                <span class="text-muted-foreground-1" aria-hidden="true">↗</span>
                            </a>
                        </li>
                    }
                </ul>
            </section>
            <section class="p-5 rounded-3xl tone-sun">
                <h2 class="font-semibold text-foreground">✨ @L["Dossier_Fact"]</h2>
                <p class="mt-1 text-sm text-foreground">@d.Fact.In(language)</p>
            </section>
        </div>
    </div>
</div>
