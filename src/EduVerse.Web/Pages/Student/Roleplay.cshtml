@page
@model EduVerse.Web.Pages.Student.RoleplayModel
@using EduVerse.Core.Gamification
@{
    ViewData["Title"] = L["Nav_Roleplay"];
    var language = EduVerse.Web.Localization.LanguageForCurrentCulture();
}
<div>
    <h1 class="text-2xl font-semibold tracking-tight text-foreground">@L["Nav_Roleplay"]</h1>
    <p class="text-sm text-muted-foreground-1">@L["Roleplay_Subtitle"]</p>
</div>

@if (Model.Chosen is null)
{
    <ul class="grid sm:grid-cols-2 gap-4" data-testid="roleplay-list">
        @foreach (var r in Roleplays.All)
        {
            var done = Model.Completed.Contains(r.Key);
            <li>
                <a href="/Student/Roleplay?scenario=@r.Key" class="@Ui.Card p-5 flex flex-row items-start gap-4 hover:-translate-y-0.5 transition-transform h-full" data-testid="roleplay-@r.Key">
                    <span class="size-14 shrink-0 rounded-2xl @(done ? "tone-mint" : "tone-sky") grid place-items-center text-3xl" aria-hidden="true">@r.Emoji</span>
                    <span class="min-w-0">
                        <span class="block text-base font-semibold text-foreground">@r.Title.In(language)@(done ? " ✅" : "")</span>
                        <span class="block mt-1 text-sm text-muted-foreground-1">@r.Setting.In(language)</span>
                        <span class="mt-2 flex flex-wrap gap-1.5">
                            <span class="@Ui.Pill bg-surface text-foreground">@L[$"Area_{r.Area}"]</span>
                            <span class="@Ui.Pill bg-surface text-foreground">🎯 @string.Format(System.Globalization.CultureInfo.CurrentCulture, L["Roleplay_Goals"], r.Goals.Count)</span>
                            <span class="@Ui.Pill tone-sun text-foreground">+@Roleplays.Xp XP · 💎 @Roleplays.GemsReward</span>
                        </span>
                    </span>
                </a>
            </li>
        }
    </ul>
}
else
{
    var r = Model.Chosen;
    EduVerse.Web.Breadcrumb.Set(ViewData, r.Title.In(language), ("/Student/Roleplay", L["Nav_Roleplay"]));
    <div class="grid lg:grid-cols-12 gap-4 sm:gap-6 items-start" id="rp-root" data-scenario="@r.Key">
        <section class="lg:col-span-8 @Ui.Card p-4 sm:p-5 min-w-0" aria-labelledby="rp-title">
            <div class="flex items-center gap-3">
                <span class="size-12 shrink-0 rounded-2xl tone-sky grid place-items-center text-2xl" aria-hidden="true">@r.Emoji</span>
                <div class="min-w-0">
                    <h2 id="rp-title" class="text-lg font-semibold text-foreground truncate">@r.Title.In(language)</h2>
                    <p class="text-sm text-muted-foreground-1" id="rp-character">@r.Character.In(language)</p>
                </div>
                <button type="button" id="rp-speak" class="@Ui.IconBtn ms-auto tip tip-b" aria-pressed="true" data-tip="@L["Quiz_ReadAloud"]" aria-label="@L["Quiz_ReadAloud"]">🔊</button>
            </div>
            <ol class="mt-4 space-y-3 max-h-[28rem] overflow-y-auto pe-1" id="rp-chat" aria-live="polite" data-testid="roleplay-chat"></ol>
            <form class="mt-4 flex items-end gap-2" id="rp-form">
                <label class="sr-only" for="rp-text">@L["Roleplay_YourLine"]</label>
                <textarea id="rp-text" rows="2" maxlength="@Roleplays.MaxMessage" class="@Ui.Input grow" placeholder="@L["Roleplay_YourLine"]" data-testid="roleplay-input"></textarea>
                <button type="button" id="rp-mic" class="@Ui.IconBtn hidden tip tip-b" data-tip="@L["Roleplay_Mic"]" aria-label="@L["Roleplay_Mic"]">🎤</button>
                <button type="submit" class="@Ui.BtnPrimary shrink-0" data-testid="roleplay-send">@L["Roleplay_Send"]</button>
            </form>
            <p class="mt-2 text-xs text-muted-foreground-1" id="rp-status" role="status"></p>
        </section>
        <aside class="lg:col-span-4 space-y-4">
            <section class="@Ui.Card p-5" aria-labelledby="rp-goals-title">
                <h2 id="rp-goals-title" class="text-base font-semibold text-foreground">🎯 @L["Roleplay_Missions"]</h2>
                <p class="text-xs text-muted-foreground-1">@L["Roleplay_MissionsHint"]</p>
                <ul class="mt-3 space-y-2" id="rp-goals" data-testid="roleplay-goals"></ul>
                <p class="mt-3 text-xs text-muted-foreground-1" id="rp-turns"></p>
            </section>
            <section class="@Ui.Card p-5 tone-lavender">
                <p class="text-sm text-foreground">@r.Setting.In(language)</p>
            </section>
        </aside>
    </div>
}

@section Scripts {
    <script src="~/js/common.js" asp-append-version="true"></script>
    <script src="~/js/roleplay.js" asp-append-version="true"></script>
}
