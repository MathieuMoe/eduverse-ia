@page
@model EduVerse.Web.Pages.Student.PipModel
@{
    ViewData["Title"] = L["Pip_Title"];
}
<div class="flex flex-wrap justify-between items-end gap-3">
    <div class="min-w-0">
        <h1 class="text-3xl font-semibold tracking-tight text-foreground">🐣 @L["Pip_Title"]</h1>
        <p class="mt-1 text-sm text-muted-foreground-1 max-w-3xl">@L["Pip_Subtitle"]</p>
    </div>
    @if (Model.Solved > 0)
    {
        <span class="@Ui.Pill tone-mint text-foreground py-1 px-3 text-sm" data-testid="pip-solved">🏅 @string.Format(System.Globalization.CultureInfo.CurrentCulture, L["Pip_Solved"].Value, Model.Solved)</span>
    }
</div>

@if (!Model.Available)
{
    <p class="@Ui.Card p-5 text-sm text-muted-foreground-1" data-testid="pip-unavailable">@L["Pip_Unavailable"]</p>
}
else
{
    <section class="@Ui.Card p-5 space-y-4" id="pp-card" aria-live="polite" data-testid="pip-card">
        <p class="text-sm text-foreground">@L["Pip_Start"]</p>
        <div class="flex flex-wrap gap-3">
            <button type="button" class="@Ui.BtnPrimary" data-pip-start="maths" data-testid="pip-start">🔢 @L["Pip_Maths"]</button>
            <button type="button" class="@Ui.BtnPrimary" data-pip-start="language" data-testid="pip-start-language">📝 @L["Pip_Language"]</button>
        </div>
    </section>
}
@if (Model.Stats.Count > 0)
{
    <section class="@Ui.Card p-5" aria-labelledby="pp-stats" data-testid="pip-stats">
        <h2 id="pp-stats" class="text-base font-semibold text-foreground">🔎 @L["Pip_Stats"]</h2>
        <ul class="mt-3 grid sm:grid-cols-2 gap-2">
            @foreach (var st in Model.Stats)
            {
                <li class="flex items-center justify-between gap-3 text-sm text-foreground"><span>@EduVerse.Core.Tutor.Pip.Describe(st.Mistake, EduVerse.Web.Localization.LanguageForCurrentCulture())</span><span class="shrink-0 font-semibold">@st.Found / @st.Total</span></li>
            }
        </ul>
    </section>
}
<p class="text-xs text-muted-foreground-1 max-w-3xl">ℹ️ @L["Pip_Footer"]</p>

@section Scripts {
    <script src="~/js/common.js" asp-append-version="true"></script>
    <script src="~/js/pip.js" asp-append-version="true"></script>
}
